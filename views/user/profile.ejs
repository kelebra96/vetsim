<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Meu Perfil • VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/profile.css">
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>
  <div class="vs-main">
    <%
      const _doc  = locals.userDoc || {};
      const _u    = locals.user    || {};
      const _msgs = locals.messages || [];
      const _ok   = locals.success  || '';

      const _name    = _doc.name    || 'Usuário';
      const _email   = _doc.email   || '—';
      const _code    = _doc.code    != null ? _doc.code : '—';
      const _sem     = _doc.semester != null ? _doc.semester : '—';
      const _bal     = Number(_doc.balance || 0);
      const _avatar  = (_doc.avatarUrl && _doc.avatarUrl.length > 0) ? _doc.avatarUrl : '/img/gato-preto.svg';
      const _type    = _doc.type || 'student';
      const _isAdmin = _u.role === 'admin' || _u.role === 'teacher';

      const roleLabel = _type === 'admin' ? 'Administrador' : _type === 'teacher' ? 'Professor' : 'Aluno';
      const roleIcon  = _type === 'admin' ? 'bi-shield-lock-fill' : _type === 'teacher' ? 'bi-mortarboard-fill' : 'bi-person-fill';
    %>

    <div style="max-width: 860px; margin: 0 auto;">

      <!-- ── Alertas ── -->
      <% if (_msgs && _msgs.length > 0) { %>
      <div class="alert alert-dismissible fade show mb-4" role="alert"
           style="background:rgba(220,38,58,0.12);border:1px solid rgba(220,38,58,0.25);color:#f87171;border-radius:12px;">
        <% _msgs.forEach(m => { %><div><i class="bi bi-exclamation-circle-fill me-2"></i><%= m %></div><% }) %>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
      </div>
      <% } %>
      <% if (_ok && _ok.length > 0) { %>
      <div class="alert alert-dismissible fade show mb-4" role="alert"
           style="background:rgba(58,181,160,0.12);border:1px solid rgba(58,181,160,0.25);color:var(--vs-accent);border-radius:12px;">
        <i class="bi bi-check-circle-fill me-2"></i><%= _ok %>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert"></button>
      </div>
      <% } %>

      <!-- ── Header ── -->
      <div class="mb-4">
        <p style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--vs-accent);margin-bottom:.25rem;">Conta</p>
        <h1 style="font-size:clamp(1.25rem,2.5vw,1.6rem);font-weight:800;color:#ffffff;letter-spacing:-.3px;margin:0;">Meu Perfil</h1>
      </div>

      <div class="row g-4">

        <!-- ── Coluna esquerda: cartão de identidade ── -->
        <div class="col-12 col-lg-4">
          <div class="prf-id-card">

            <div class="prf-avatar-wrap">
              <img id="avatarDisplay" src="<%= _avatar %>" alt="Avatar" class="prf-avatar">
              <div class="prf-avatar-ring"></div>
            </div>

            <h2 class="prf-name"><%= _name %></h2>
            <span class="prf-role-badge <%= _type %>">
              <i class="bi <%= roleIcon %>"></i> <%= roleLabel %>
            </span>

            <hr class="prf-divider">

            <div class="prf-info-row">
              <span class="prf-info-label"><i class="bi bi-envelope-fill"></i> E-mail</span>
              <span class="prf-info-val" style="font-size:.75rem;word-break:break-all;text-align:right;max-width:55%"><%= _email %></span>
            </div>
            <div class="prf-info-row">
              <span class="prf-info-label"><i class="bi bi-hash"></i> Código</span>
              <span class="prf-info-val"><%= _code %></span>
            </div>
            <div class="prf-info-row">
              <span class="prf-info-label"><i class="bi bi-mortarboard"></i> Semestre</span>
              <span class="prf-info-val"><%= _sem %></span>
            </div>

            <hr class="prf-divider">

            <div class="prf-info-row">
              <span class="prf-info-label"><i class="bi bi-cash-stack"></i> Saldo VIDA</span>
              <span class="prf-info-val balance">
                <%= _bal.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL', maximumFractionDigits: 0 }) %>
              </span>
            </div>

            <% if (_isAdmin && _doc._id) { %>
            <a class="btn-prf-adjust" href="/users/edit/<%= _doc._id %>">
              <i class="bi bi-cash-coin"></i> Ajustar Saldo VIDA
            </a>
            <% } %>

          </div>
        </div>

        <!-- ── Coluna direita: formulário de edição ── -->
        <div class="col-12 col-lg-8">
          <div class="prf-form-panel">
            <div class="prf-form-header">
              <div class="prf-form-title"><i class="bi bi-pencil-square me-2" style="color:var(--vs-accent)"></i>Editar Informações</div>
              <div class="prf-form-sub">Altere seu nome de exibição ou foto de perfil</div>
            </div>

            <div class="prf-form-body">
              <form action="/profile" method="POST" enctype="multipart/form-data">

                <!-- Nome -->
                <div class="mb-4">
                  <label class="prf-field-label" for="prf-name">
                    <i class="bi bi-person-fill"></i> Nome
                  </label>
                  <input
                    type="text"
                    id="prf-name"
                    name="name"
                    class="form-control prf-field"
                    required
                    minlength="2"
                    maxlength="80"
                    value="<%= _name %>"
                    placeholder="Seu nome completo"
                  >
                  <div class="prf-field-hint">Entre 2 e 80 caracteres.</div>
                </div>

                <!-- Avatar -->
                <div class="mb-4">
                  <label class="prf-field-label">
                    <i class="bi bi-image-fill"></i> Foto de Perfil
                  </label>
                  <label class="prf-avatar-preview-wrap" for="avatarInput">
                    <img id="avatarThumb" src="<%= _avatar %>" alt="Preview" class="prf-avatar-thumb">
                    <div>
                      <div class="prf-avatar-pick-label">Clique para selecionar uma imagem</div>
                      <div class="prf-avatar-pick-sub" id="avatarFileName">PNG, JPG, JPEG, GIF, WEBP — máx. 2 MB</div>
                    </div>
                    <input type="file" id="avatarInput" name="avatar" accept="image/*">
                  </label>
                </div>

                <button type="submit" class="btn-prf-save">
                  <i class="bi bi-floppy-fill me-2"></i>Salvar Perfil
                </button>

              </form>
            </div>
          </div>
        </div>

      </div>
    </div>

    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/gamification.js"></script>
    <script>
      (function () {
        // Auto-dismiss alerts
        document.querySelectorAll('.alert').forEach(function (el) {
          setTimeout(function () {
            try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch (_) {}
          }, 5000);
        });

        // Preview de avatar antes do upload
        const input = document.getElementById('avatarInput');
        if (!input) return;
        input.addEventListener('change', function () {
          const file = this.files[0];
          if (!file) return;
          document.getElementById('avatarFileName').textContent = file.name;
          const reader = new FileReader();
          reader.onload = function (e) {
            const src = e.target.result;
            const thumb = document.getElementById('avatarThumb');
            const disp  = document.getElementById('avatarDisplay');
            if (thumb) thumb.src = src;
            if (disp)  disp.src  = src;
          };
          reader.readAsDataURL(file);
        });
      })();
    </script>
  </div>
</body>
</html>
