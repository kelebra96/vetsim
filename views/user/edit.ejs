<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Editar Usuário - VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h1 class="vs-title h4 mb-0">Editar Usuário</h1>
      <a class="btn btn-outline-light btn-sm" href="/users"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
    </div>

    <% if (messages && messages.length>0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= messages[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% } %>
    <% if (success && success.length>0) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% } %>

    <div class="vs-card p-3">
      <form action="/users/edit/<%= u._id %>" method="POST">
        <div class="row g-3">
          <div class="col-12 col-md-6">
            <label class="form-label">Nome</label>
            <input type="text" name="name" class="form-control" value="<%= u.name %>" required>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label">Código</label>
            <input type="number" name="code" class="form-control" value="<%= u.code %>" min="1" step="1">
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label">Semestre</label>
            <input type="number" name="semester" class="form-control" value="<%= u.semester %>" min="1" max="8">
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" class="form-control" value="<%= u.email %>" required>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label">Tipo</label>
            <select name="type" class="form-select">
              <option value="student" <%= u.type==='student'?'selected':'' %>>Aluno</option>
              <option value="teacher" <%= u.type==='teacher'?'selected':'' %>>Professor</option>
              <option value="admin" <%= u.type==='admin'?'selected':'' %>>Admin</option>
            </select>
          </div>
          <div class="col-6 col-md-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
              <option value="1" <%= u.status ? 'selected' : '' %>>Ativo</option>
              <option value="0" <%= !u.status ? 'selected' : '' %>>Inativo</option>
            </select>
          </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
          <a class="btn btn-secondary" href="/users">Cancelar</a>
          <button type="button" class="btn btn-outline-light" data-bs-toggle="modal" data-bs-target="#resetPassModal"><i class="bi bi-key me-1"></i>Redefinir Senha</button>
          <button type="submit" class="btn btn-vs-dark"><i class="bi bi-check2 me-1"></i>Salvar</button>
        </div>
      </form>
    </div>
    <!-- Modal Reset Password -->
    <div class="modal fade" id="resetPassModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content vs-modal">
          <div class="modal-header">
            <h5 class="modal-title"><i class="bi bi-key me-2"></i>Redefinir Senha</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
          </div>
          <form action="/users/<%= u._id %>/resetpass" method="POST">
            <div class="modal-body">
              <div class="mb-3">
                <label class="form-label">Nova senha</label>
                <input type="password" class="form-control" name="password" minlength="6" required>
              </div>
              <div class="mb-1">
                <label class="form-label">Confirmar senha</label>
                <input type="password" class="form-control" name="confirm" minlength="6" required>
              </div>
              <small class="text-white-50">Mínimo 6 caracteres.</small>
            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
              <button type="submit" class="btn btn-vs-dark"><i class="bi bi-check2 me-1"></i>Confirmar</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <div id="toast-container"></div>
</body>
</html>
