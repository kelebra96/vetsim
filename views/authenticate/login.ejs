<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/img/gato-preto.svg" />
  <title>Entrar • VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/login.css">
</head>
<body class="vs-gradient login-page">
  <main class="login-shell">
    <section class="login-panel login-brand">
      <div class="login-brand-badge">Sistema Acadêmico</div>
      <h1 class="login-brand-title">VetSim</h1>
      <p class="login-brand-sub">Plataforma de gestão veterinária com rounds, simulação populacional e análise de desempenho.</p>

      <div class="login-brand-features">
        <div class="login-feature">
          <i class="bi bi-graph-up-arrow"></i>
          <span>Métricas e evolução em tempo real</span>
        </div>
        <div class="login-feature">
          <i class="bi bi-shield-check"></i>
          <span>Rastreabilidade de ações administrativas</span>
        </div>
        <div class="login-feature">
          <i class="bi bi-people-fill"></i>
          <span>Fluxo por aluno, professor e administração</span>
        </div>
      </div>

      <div class="login-brand-footer">
        <img src="/img/baraomaua.svg" alt="Barão de Mauá" class="login-maua-logo">
      </div>
    </section>

    <section class="login-panel login-form-panel">
      <img src="/img/felinos.png" alt="" class="login-bg-cat" aria-hidden="true">

      <div class="login-form-inner">
        <div class="login-form-head">
          <h2 class="login-form-title">Acessar conta</h2>
          <p class="login-form-sub">Entre com seu e-mail institucional e senha.</p>
        </div>

        <% if (messages && messages.length > 0) { %>
          <div class="alert alert-dismissible fade show login-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span><%= messages[0] %></span>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
          </div>
        <% } %>

        <form action="/login" method="POST" class="login-form" novalidate>
          <label class="login-label" for="email">E-mail</label>
          <div class="login-field">
            <i class="bi bi-envelope"></i>
            <input id="email" type="email" class="form-control" name="email" required placeholder="usuario@dominio.com">
          </div>

          <label class="login-label" for="password">Senha</label>
          <div class="login-field">
            <i class="bi bi-lock"></i>
            <input id="password" type="password" class="form-control" name="password" required placeholder="••••••••">
          </div>

          <button type="submit" class="btn login-submit">
            <i class="bi bi-box-arrow-in-right"></i>
            Entrar
          </button>
        </form>

        <div class="login-links">
          <a href="/forgot-password">Esqueci minha senha</a>
          <a href="https://www.baraodemaua.br" target="_blank" rel="noopener">Não tem conta? Entre em contato</a>
        </div>

        <p class="login-dev">Desenvolvido por Rodrigo A. Almeida</p>
      </div>
    </section>
  </main>

  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function(){
      document.querySelectorAll('.alert').forEach(function(el){
        setTimeout(function(){ try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch (_) {} }, 5000);
      });
    })();
  </script>
</body>
</html>
