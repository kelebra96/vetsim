<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Cadastro • VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/register.css">
</head>
<body class="vs-gradient">
  <%
    const __errors  = (locals.messages && messages.length) ? messages : [];
    const __success = (locals.success  && success.length)  ? success  : [];
    const __isStaff = locals.user && (user.role === 'teacher' || user.role === 'admin');
  %>
  <%- include('../partials/navbar') %>
  <div class="vs-main">
  <div class="reg-page">
    <div class="reg-card">

      <!-- ── Header ── -->
      <div class="reg-card-header">
        <div class="reg-logo"><i class="bi bi-heart-pulse-fill"></i></div>
        <h1 class="reg-title">Criar conta</h1>
        <p class="reg-sub">Preencha os dados abaixo para se cadastrar no VetSim</p>
      </div>

      <!-- ── Body ── -->
      <div class="reg-card-body">

        <!-- Alertas -->
        <% if (__errors.length > 0) { %>
        <div class="reg-alert error">
          <i class="bi bi-exclamation-circle-fill"></i>
          <ul class="mb-0 ps-2">
            <% __errors.forEach(m => { %><li><%= m %></li><% }) %>
          </ul>
        </div>
        <% } %>
        <% if (__success.length > 0) { %>
        <div class="reg-alert success">
          <i class="bi bi-check-circle-fill"></i>
          <%= __success[0] %>
        </div>
        <% } %>

        <form action="/createuser" method="POST">

          <!-- Dados pessoais -->
          <p class="reg-section-label">Dados pessoais</p>
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-8">
              <div class="reg-field-wrap">
                <label class="reg-label" for="nameInput"><i class="bi bi-person-fill"></i> Nome</label>
                <input type="text" class="reg-input form-control" id="nameInput" name="name"
                       required minlength="2" maxlength="80" placeholder="Seu nome completo">
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="reg-field-wrap">
                <label class="reg-label" for="codeInput"><i class="bi bi-hash"></i> Código</label>
                <input type="number" class="reg-input form-control" id="codeInput" name="code"
                       required min="1" max="9999999" step="1" placeholder="Ex: 1001">
              </div>
            </div>
          </div>

          <!-- Acesso -->
          <p class="reg-section-label">Acesso</p>
          <div class="row g-3 mb-3">
            <div class="col-12 col-md-6">
              <div class="reg-field-wrap">
                <label class="reg-label" for="emailInput"><i class="bi bi-envelope-fill"></i> E-mail</label>
                <input type="email" class="reg-input form-control" id="emailInput" name="email"
                       required placeholder="seu@email.com">
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="reg-field-wrap">
                <label class="reg-label" for="passwordInput"><i class="bi bi-lock-fill"></i> Senha</label>
                <div class="reg-pw-wrap">
                  <input type="password" class="reg-input form-control" id="passwordInput" name="password"
                         required placeholder="Mínimo 6 caracteres">
                  <button type="button" class="reg-pw-toggle" id="pwToggle" tabindex="-1" aria-label="Mostrar senha">
                    <i class="bi bi-eye-fill" id="pwToggleIcon"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Configurações da conta -->
          <p class="reg-section-label">Configurações da conta</p>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <div class="reg-field-wrap">
                <label class="reg-label" for="semesterInput"><i class="bi bi-mortarboard-fill"></i> Semestre</label>
                <select class="reg-input form-select" id="semesterInput" name="semester" required>
                  <% for(let i = 1; i <= 8; i++) { %>
                  <option value="<%= i %>"><%= i %>º Semestre</option>
                  <% } %>
                </select>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="reg-field-wrap">
                <label class="reg-label" for="typeSelect"><i class="bi bi-shield-fill"></i> Tipo</label>
                <select class="reg-input form-select" id="typeSelect" name="type" required>
                  <option value="student" selected>Aluno</option>
                  <option value="teacher">Professor</option>
                  <option value="admin">Administrador</option>
                </select>
              </div>
            </div>
            <div class="col-12 col-md-4">
              <div class="reg-field-wrap">
                <label class="reg-label" for="statusSelect"><i class="bi bi-toggle-on"></i> Status</label>
                <select class="reg-input form-select" id="statusSelect" name="status" required>
                  <option value="true" selected>Ativo</option>
                  <option value="false">Inativo</option>
                </select>
              </div>
            </div>
          </div>

          <button type="submit" class="btn-reg-submit">
            <i class="bi bi-person-plus-fill me-2"></i>Criar Conta
          </button>

        </form>
      </div>

      <!-- ── Footer ── -->
      <div class="reg-card-footer">
        <a href="/" class="reg-footer-link">
          <i class="bi bi-arrow-left me-1"></i> Já tem conta? <strong>Entrar</strong>
        </a>
        <% if (__isStaff) { %>
        <button class="btn-reg-import" data-bs-toggle="modal" data-bs-target="#importStudentsModal">
          <i class="bi bi-file-earmark-arrow-up-fill"></i> Importar via planilha
        </button>
        <% } %>
      </div>

    </div>
  </div>

  <!-- ── Modal importar alunos (apenas staff) ── -->
  <% if (__isStaff) { %>
  <div class="modal fade reg-modal" id="importStudentsModal" tabindex="-1" aria-labelledby="importStudentsLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="importStudentsLabel">
            <i class="bi bi-people-fill me-2" style="color:var(--vs-accent)"></i>Importar Alunos
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
        </div>
        <div class="modal-body">
          <p style="font-size:.82rem;color:rgba(255,255,255,0.50);margin-bottom:.75rem;">
            Campos obrigatórios: <strong style="color:rgba(255,255,255,0.70)">Nome, Código, E-mail, Semestre, Senha</strong>.
            Status e tipo serão definidos como <em>Ativo</em> e <em>Aluno</em> por padrão.
          </p>
          <ul style="font-size:.78rem;color:rgba(255,255,255,0.40);margin-bottom:1.25rem;padding-left:1.25rem;">
            <li>A primeira linha deve ser o cabeçalho.</li>
            <li>CSV: separador vírgula &nbsp;|&nbsp; XLSX: qualquer planilha.</li>
          </ul>
          <form id="importForm" action="/importstudents" method="POST" enctype="multipart/form-data">
            <div class="reg-dropzone" id="dropzone">
              <div class="dz-icon"><i class="bi bi-cloud-upload-fill"></i></div>
              <div>Arraste o arquivo aqui ou <span style="color:var(--vs-accent);text-decoration:underline">clique para selecionar</span></div>
              <small class="d-block mt-1">Formatos aceitos: .csv, .xlsx</small>
              <input id="fileInput" type="file" name="file" accept=".csv,.xlsx" hidden required>
              <div id="fileName" style="font-size:.78rem;color:var(--vs-accent);margin-top:.6rem;"></div>
              <a id="templateLink" href="#" style="font-size:.75rem;color:rgba(255,255,255,0.35);display:inline-block;margin-top:.5rem;text-decoration:none;">
                <i class="bi bi-filetype-csv me-1"></i>Baixar modelo CSV
              </a>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-3">
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
              <button class="btn btn-sm" type="submit"
                      style="background:linear-gradient(90deg,var(--vs-accent),#52c8b4);color:#071a17;font-weight:700;border:none;border-radius:8px;padding:.4rem 1.1rem;">
                <i class="bi bi-upload me-1"></i> Importar
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  <% } %>

  </div><!-- /.vs-main -->
  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function () {
      // Auto-dismiss alertas
      document.querySelectorAll('.alert').forEach(function (el) {
        setTimeout(function () {
          try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch (_) {}
        }, 5000);
      });

      // Toggle visibilidade senha
      const pwToggle = document.getElementById('pwToggle');
      const pwInput  = document.getElementById('passwordInput');
      const pwIcon   = document.getElementById('pwToggleIcon');
      if (pwToggle && pwInput) {
        pwToggle.addEventListener('click', function () {
          const isPass = pwInput.type === 'password';
          pwInput.type = isPass ? 'text' : 'password';
          pwIcon.className = isPass ? 'bi bi-eye-slash-fill' : 'bi bi-eye-fill';
        });
      }

      // Dropzone
      const dz = document.getElementById('dropzone');
      const fi = document.getElementById('fileInput');
      const fn = document.getElementById('fileName');
      const tl = document.getElementById('templateLink');
      if (dz && fi) {
        dz.addEventListener('click', function (e) {
          if (!e.target.closest('#templateLink')) fi.click();
        });
        dz.addEventListener('dragover',  function (e) { e.preventDefault(); dz.classList.add('dragover'); });
        dz.addEventListener('dragleave', function ()  { dz.classList.remove('dragover'); });
        dz.addEventListener('drop', function (e) {
          e.preventDefault(); dz.classList.remove('dragover');
          if (e.dataTransfer?.files?.[0]) {
            fi.files = e.dataTransfer.files;
            if (fn) fn.textContent = e.dataTransfer.files[0].name;
          }
        });
        fi.addEventListener('change', function () {
          if (fn && fi.files[0]) fn.textContent = fi.files[0].name;
        });
      }
      if (tl) {
        const sample = 'Nome,Código,E-mail,Semestre,Senha\nAna Lima,1001,ana@example.com,1,Senha@123\n';
        const blob = new Blob([sample], { type: 'text/csv;charset=utf-8;' });
        tl.href = URL.createObjectURL(blob);
        tl.download = 'modelo_alunos.csv';
      }

      // Abre modal se ?import=1
      if (new URLSearchParams(window.location.search).get('import') === '1') {
        const el = document.getElementById('importStudentsModal');
        if (el && window.bootstrap) new bootstrap.Modal(el).show();
      }
    })();
  </script>
</body>
</html>
