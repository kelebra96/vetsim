<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Meu XP</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body>
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <h1 class="vs-title h3 mb-3">Meu XP</h1>
    <% if (messages && messages.length>0) { %>
      <div class="alert alert-danger"><%= messages[0] %></div>
    <% } %>
    <% if (success && success.length>0) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>

    <div class="card vs-card mb-4">
      <div class="card-body d-flex justify-content-between align-items-center">
        <div>
          <div class="fs-5">Nível <strong><%= summary.level %></strong></div>
          <div class="text-white-50 small">Progresso: <%= summary.inLevel %>/100 XP</div>
        </div>
        <div class="vs-xpbar" style="width:220px"><div class="fill" style="width:<%= Math.min(100, Math.max(0, summary.inLevel)) %>%"></div></div>
        <div class="ms-3">Total: <strong><%= summary.points %> XP</strong></div>
      </div>
    </div>

    <% if (user && Array.isArray(user.xpBySemester)) { %>
      <div class="card vs-card mb-4">
        <div class="card-body">
          <div class="row g-3">
            <% for (let i=1;i<=8;i++){ const val=(user.xpBySemester[i-1]||0); const pct = Math.min(100, Math.max(0, val % 100)); %>
              <div class="col-12 col-md-3">
                <div class="text-white-50 small mb-1">Semestre <%= i %>: <%= val %> XP</div>
                <div class="vs-xpbar" style="width:100%"><div class="fill" style="width:<%= pct %>%"></div></div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

    <div class="table-responsive">
      <table class="table table-dark table-striped align-middle">
        <thead>
          <tr>
            <th>Data</th>
            <th>Pontos</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody>
          <% (events || []).forEach(ev => { %>
            <tr>
              <td><%= new Date(ev.createdAt).toLocaleString('pt-BR') %></td>
              <td><span class="badge text-bg-success">+<%= ev.amount %> XP</span></td>
              <td><%= ev.reason || '-' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
