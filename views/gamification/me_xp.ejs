<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Meu XP</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>
  <div class="container py-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-3">
      <h1 class="vs-title h4 mb-0">Meu XP</h1>
      <button id="btnExportEvents" class="btn btn-vs-dark btn-sm w-100 w-md-auto">
        <i class="bi bi-download me-1"></i> Exportar histórico CSV
      </button>
    </div>

    <% if (messages && messages.length>0) { %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= messages[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% } %>
    <% if (success && success.length>0) { %>
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= success[0] %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% } %>

    <% const nextLevel = Math.max(0, 100 - (summary.inLevel % 100)); %>

    <section class="card vs-card mb-4">
      <div class="card-body row g-3 align-items-center">
        <div class="col-12 col-lg-4">
          <p class="text-white-50 mb-1">Nível atual</p>
          <p class="fs-3 fw-bold mb-0">Nível <%= summary.level %></p>
          <small class="text-white-50">Total acumulado: <strong><%= summary.points %> XP</strong></small>
        </div>
        <div class="col-12 col-lg-5">
          <div class="text-white-50 small mb-1">Progresso no semestre</div>
          <div class="vs-xpbar" style="width:100%">
            <div class="fill" style="width:<%= Math.min(100, Math.max(0, summary.inLevel)) %>%"></div>
          </div>
          <small class="text-white-50 d-block mt-1"><%= summary.inLevel %>/100 XP</small>
        </div>
        <div class="col-12 col-lg-3 text-lg-end">
          <p class="text-white-50 small mb-1">XP restante</p>
          <p class="fs-4 fw-semibold mb-0"><%= nextLevel %> XP</p>
          <small class="text-white-50">para o próximo nível</small>
        </div>
      </div>
    </section>

    <section class="row g-3 mb-4">
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="vs-card p-3 d-flex flex-column gap-1">
          <span class="text-white-50 small">XP Total</span>
          <span class="fs-4 fw-semibold"><%= summary.points %></span>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="vs-card p-3 d-flex flex-column gap-1">
          <span class="text-white-50 small">Nível</span>
          <span class="fs-4 fw-semibold"><%= summary.level %></span>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="vs-card p-3 d-flex flex-column gap-1">
          <span class="text-white-50 small">Para o próximo nível</span>
          <span class="fs-4 fw-semibold"><%= nextLevel %> XP</span>
        </div>
      </div>
      <div class="col-12 col-sm-6 col-xl-3">
        <div class="vs-card p-3 d-flex flex-column gap-1">
          <span class="text-white-50 small d-flex align-items-center gap-2">
            <i class="bi bi-fire text-warning"></i> Sequência diária
          </span>
          <span class="fs-4 fw-semibold"><%= Number(summary.streak || 0) %> dia(s)</span>
        </div>
      </div>
    </section>

    <% if (user && Array.isArray(user.xpBySemester)) { %>
      <section class="card vs-card mb-4">
        <div class="card-body">
          <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-3 gap-2">
            <div>
              <p class="mb-0 text-white-50 small">XP por semestre</p>
              <h2 class="h5 text-white mb-0">Distribuição dos 8 semestres</h2>
            </div>
            <span class="badge bg-dark-subtle text-dark">Seu semestre atual: <strong><%= user.semester %></strong></span>
          </div>
          <div class="row g-3">
            <% for (let i = 1; i <= 8; i++) {
                 const val = (user.xpBySemester[i - 1] || 0);
                 const pct = Math.min(100, Math.max(0, val % 100));
                 const isCur = Number(user.semester) === i;
            %>
              <div class="col-12 col-sm-6 col-xl-3">
                <div class="vs-sem-card <%= isCur ? 'vs-sem-current' : '' %> h-100">
                  <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-white-50 small">Semestre <%= i %></span>
                    <% if (isCur) { %><span class="badge bg-info text-dark">Atual</span><% } %>
                  </div>
                  <strong class="d-block mb-2"><%= val %> XP</strong>
                  <div class="vs-xpbar" style="width:100%">
                    <div class="fill" style="width:<%= pct %>%"></div>
                  </div>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <section class="vs-card p-0">
      <div class="table-responsive">
        <table class="table table-dark table-striped align-middle mb-0">
          <thead>
            <tr>
              <th>Data</th>
              <th>Pontos</th>
              <th>Ação</th>
            </tr>
          </thead>
          <tbody>
            <% if (!events || events.length === 0) { %>
              <tr>
                <td colspan="3" class="text-center text-white-50 py-4">Nenhum evento de XP encontrado.</td>
              </tr>
            <% } else { %>
              <% events.forEach(ev => { %>
                <tr>
                  <td><%= new Date(ev.createdAt).toLocaleString('pt-BR') %></td>
                  <td><span class="badge text-bg-success">+<%= ev.amount %> XP</span></td>
                  <td><%= ev.reason || '-' %></td>
                </tr>
              <% }) %>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function(){
      document.querySelectorAll('.alert').forEach(el => setTimeout(()=>{
        try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch(_){}
      }, 5000));
    })();
  </script>
  <script>
    (function(){
      const btn = document.getElementById('btnExportEvents');
      if (!btn) return;
      btn.addEventListener('click', function(){
        const rows = Array.from(document.querySelectorAll('table tbody tr'))
          .filter(tr => !tr.querySelector('td[colspan]'))
          .map(tr => Array.from(tr.querySelectorAll('td')).map(td => td.innerText.trim()));
        const head = ['Data','Pontos','Ação'];
        const lines = [head.join(',')];
        rows.forEach(r => lines.push(r.map(v => '"'+v.replaceAll('"','""')+'"').join(',')));
        const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = 'meu_xp.csv'; a.click();
        setTimeout(()=> URL.revokeObjectURL(url), 1000);
      });
    })();
  </script>
</body>
</html>
