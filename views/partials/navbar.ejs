<nav class="navbar navbar-expand-lg navbar-dark" id="navbarHome" style="background-color:#000000 !important;">
  <div class="container-fluid">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/home">
      <% if (user) { %>
        <span class="navbar-avatar">
          <img src="<%= user.avatarUrl && user.avatarUrl.length ? user.avatarUrl : '/img/gato-preto.svg' %>" alt="Avatar do usuário" loading="lazy">
        </span>
        <span class="navbar-name"><%= user.name || 'Usuário' %></span>
      <% } else { %>
        <span class="navbar-name">VetSim</span>
      <% } %>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
      aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Alternar navegação">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <a class="nav-link active" aria-current="page" href="/home">Home</a>
        </li>
        <% if (user && (user.role === "admin" || user.role === "teacher")) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Usuários
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/register">Criação</a></li>
              <li><a class="dropdown-item" href="/users">Atualização</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/users">Lista de Usuários</a></li>
            </ul>
          </li>
        <% } %>
        <li class="nav-item">
          <a class="nav-link active" href="/sobre">Sobre</a>
        </li>
        <% if (user && (user.role === "admin" || user.role === "teacher")) { %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Rounds
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/roundcreate">Criação</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/roundclose">Fechar Round</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/roundsadmin">Por Semestre</a></li>
            </ul>
          </li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              Configurações
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/settings/costs">Custos</a></li>
              <li><a class="dropdown-item" href="/logs">Logs de Ações</a></li>
            </ul>
          </li>
        <% } %>
      </ul>

      <div class="vs-hud d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-3 ms-lg-auto mt-3 mt-lg-0">
        <div class="nav-item d-flex align-items-center justify-content-center justify-content-lg-start">
          <% const __bal = (user && typeof user.balance === "number") ? Number(user.balance) : 0; %>
          <span class="badge bg-dark border text-center px-3" title="Saldo VIDA" style="border-color: rgba(255,255,255,0.15) !important;">
            <i class="bi bi-cash-coin me-1"></i>
            <%= __bal.toLocaleString("pt-BR", { style:"currency", currency:"BRL" }) %>
          </span>
        </div>

        <div class="vs-streak justify-content-center" title="Sequência diária">
          <i class="bi bi-fire" aria-hidden="true"></i>
          <span id="streak-value" aria-live="polite">0</span>
        </div>

        <div class="d-flex flex-column align-items-center align-items-lg-start text-center text-lg-start">
          <span class="vs-level">Nível <span id="level-value" data-lock="true"><%= (user && typeof user.level === "number") ? user.level : 1 %></span></span>
          <%
            const _sem = (user && typeof user.semester === "number") ? user.semester : 1;
            const _xpArr = (user && Array.isArray(user.xpBySemester)) ? user.xpBySemester : [];
            const _cur = (_xpArr[_sem-1] || 0);
            const _in = ((_cur % 100) + 100) % 100;
            const _pct = Math.min(100, Math.max(0, _in));
          %>
          <div class="vs-xpbar">
            <div class="fill" id="xp-progress-inner" data-lock="true" style="width: <%= _pct %>%;"></div>
          </div>
          <small class="text-white-50"><%= _in %>/100 XP (Semestre <%= _sem %>)</small>
        </div>

        <div class="nav-item d-flex align-items-center justify-content-center justify-content-lg-start">
          <a class="nav-link" href="/me/xp">
            <i class="bi bi-trophy me-1"></i> Meu XP
          </a>
        </div>

        <div class="nav-item d-flex align-items-center justify-content-center justify-content-lg-start">
          <a class="nav-link" href="/profile">
            <i class="bi bi-person-circle me-1"></i> Meu Perfil
          </a>
        </div>

        <div class="nav-item d-flex justify-content-center justify-content-lg-start">
          <a class="nav-link active d-flex align-items-center" href="/logout">
            <i class="bi bi-door-open me-1"></i> Logout
          </a>
        </div>
      </div>
    </div>
  </div>
</nav>

<div id="toast-container"></div>
<script>
  // Expor XP real do servidor para sincronizar localStorage entre abas
  window.__serverXP = <%= (user && typeof user.points === "number") ? Number(user.points) : 0 %>;
  window.__serverStreak = <%= (user && typeof user.streakCount === "number") ? Number(user.streakCount) : 0 %>;
</script>
