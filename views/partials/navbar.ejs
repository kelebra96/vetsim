<%
  const _p = locals.path || '';
  const _u = locals.user;
  const _bal = _u ? (Number.isFinite(Number(_u.balance)) ? Number(_u.balance) : 50000) : 0;
  const _sem = (_u && typeof _u.semester === 'number') ? _u.semester : 1;
  const _xpArr = (_u && Array.isArray(_u.xpBySemester)) ? _u.xpBySemester : [];
  const _cur = Number(_xpArr[_sem - 1] || 0);
  const _in = ((_cur % 100) + 100) % 100;
  const _pct = Math.min(100, Math.max(0, _in));
  const _isAdmin = _u && (_u.role === 'admin' || _u.role === 'teacher');
  function _active(route) { return _p === route ? 'vs-nav-active' : ''; }
%>

<!-- Mobile topbar -->
<div class="vs-topbar d-lg-none">
  <button class="vs-sidebar-toggle" id="sidebarToggle" aria-label="Abrir menu">
    <i class="bi bi-list"></i>
  </button>
  <span class="vs-topbar-brand">
    <img src="/img/gato-preto.svg" alt="VetSim" width="22" height="22">
    VetSim
  </span>
  <button class="vs-fullscreen-toggle" id="mobileFullscreenToggle" aria-label="Alternar tela cheia" title="Tela cheia">
    <i class="bi bi-arrows-fullscreen" id="mobileFullscreenIcon"></i>
  </button>
</div>

<!-- Overlay mobile -->
<div class="vs-sidebar-overlay" id="sidebarOverlay"></div>

<!-- Sidebar -->
<aside class="vs-sidebar" id="vsSidebar">

  <!-- Brand -->
  <div class="vs-sb-brand">
    <img src="/img/gato-preto.svg" alt="logo" width="30" height="30">
    <span class="vs-sb-brand-name">VetSim</span>
  </div>

  <!-- Perfil do usuário -->
  <% if (_u) { %>
  <div class="vs-sb-profile">
    <div class="vs-sb-avatar">
      <img src="<%= _u.avatarUrl && _u.avatarUrl.length ? _u.avatarUrl : '/img/gato-preto.svg' %>" alt="Avatar" onerror="this.onerror=null;this.src='/img/gato-preto.svg'">
    </div>
    <div class="vs-sb-profile-info">
      <span class="vs-sb-name"><%= _u.name || 'Usuário' %></span>
      <span class="vs-sb-role"><%= _u.role === 'admin' ? 'Administrador' : _u.role === 'teacher' ? 'Professor' : 'Aluno' %> · Sem. <%= _sem %></span>
    </div>
  </div>

  <!-- HUD — apenas alunos -->
  <% if (!_isAdmin) { %>
  <div class="vs-sb-hud">
    <div class="vs-sb-hud-row">
      <i class="bi bi-cash-coin vs-sb-hud-icon"></i>
      <span class="vs-sb-hud-label">Saldo VIDA</span>
      <span class="vs-sb-hud-val"><%= _bal.toLocaleString('pt-BR', { style:'currency', currency:'BRL' }) %></span>
    </div>
    <div class="vs-sb-hud-row">
      <i class="bi bi-fire vs-sb-hud-icon" style="color:#d4890a"></i>
      <span class="vs-sb-hud-label">Sequência</span>
      <span class="vs-sb-hud-val" id="streak-value"><%= (_u && _u.streakCount) || 0 %></span>
    </div>
    <div class="vs-sb-hud-xp">
      <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="vs-sb-hud-label">Nível <strong id="level-value" data-lock="true"><%= (_u && _u.level) || 1 %></strong></span>
        <span class="vs-sb-hud-val" style="font-size:.7rem"><%= _in %>/100 XP</span>
      </div>
      <div class="vs-xpbar w-100">
        <div class="fill" id="xp-progress-inner" data-lock="true" style="width:<%= _pct %>%"></div>
      </div>
    </div>
  </div>
  <% } %>
  <% } %>

  <!-- Navegação -->
  <nav class="vs-sb-nav">
    <p class="vs-sb-nav-label">Principal</p>
    <a href="/home" class="vs-sb-link <%= _active('/home') %>">
      <i class="bi bi-house-door-fill"></i> Home
    </a>
    <% if (!_isAdmin) { %>
    <a href="/rounds" class="vs-sb-link <%= _active('/rounds') %>">
      <i class="bi bi-arrow-repeat"></i> Meu Round
    </a>
    <% } %>
    <% if (!_isAdmin) { %>
    <a href="/me/xp" class="vs-sb-link <%= _active('/me/xp') %>">
      <i class="bi bi-trophy-fill"></i> Meu XP
    </a>
    <% } %>
    <a href="/profile" class="vs-sb-link <%= _active('/profile') %>">
      <i class="bi bi-person-fill"></i> Meu Perfil
    </a>

    <% if (_isAdmin) { %>
    <p class="vs-sb-nav-label mt-3">Gestão</p>
    <a href="/register" class="vs-sb-link <%= _active('/register') %>">
      <i class="bi bi-person-plus-fill"></i> Criar Usuário
    </a>
    <a href="/users" class="vs-sb-link <%= _active('/users') %>">
      <i class="bi bi-people-fill"></i> Usuários
    </a>
    <a href="/roundcreate" class="vs-sb-link <%= _active('/roundcreate') %>">
      <i class="bi bi-plus-circle-fill"></i> Criar Round
    </a>
    <a href="/roundclose" class="vs-sb-link <%= _active('/roundclose') %>">
      <i class="bi bi-flag-fill"></i> Fechar Round
    </a>
    <a href="/roundsadmin" class="vs-sb-link <%= _active('/roundsadmin') %>">
      <i class="bi bi-grid-3x3-gap-fill"></i> Rounds por Semestre
    </a>

    <p class="vs-sb-nav-label mt-3">Sistema</p>
    <a href="/settings/costs" class="vs-sb-link <%= _active('/settings/costs') %>">
      <i class="bi bi-gear-fill"></i> Configurações
    </a>
    <a href="/logs" class="vs-sb-link <%= _active('/logs') %>">
      <i class="bi bi-journal-text"></i> Logs de Ações
    </a>
    <% } %>

    <p class="vs-sb-nav-label mt-3">Outros</p>
    <a href="/sobre" class="vs-sb-link <%= _active('/sobre') %>">
      <i class="bi bi-info-circle-fill"></i> Sobre
    </a>
  </nav>

  <!-- Logout -->
  <div class="vs-sb-footer">
    <a href="/logout" class="vs-sb-link vs-sb-logout">
      <i class="bi bi-box-arrow-left"></i> Sair
    </a>
  </div>

</aside>

<div id="toast-container"></div>
<script>
  window.__serverXP = <%= (_u && typeof _u.points === 'number') ? Number(_u.points) : 0 %>;
  window.__serverStreak = <%= (_u && typeof _u.streakCount === 'number') ? Number(_u.streakCount) : 0 %>;
  window.__userRole = '<%= (_u && _u.role) ? _u.role : "student" %>';

  (function () {
    const toggle = document.getElementById('sidebarToggle');
    const overlay = document.getElementById('sidebarOverlay');
    const sidebar = document.getElementById('vsSidebar');
    function openSidebar() {
      sidebar.classList.add('vs-sidebar-open');
      overlay.classList.add('vs-sidebar-overlay-show');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('vs-sidebar-open');
      overlay.classList.remove('vs-sidebar-overlay-show');
      document.body.style.overflow = '';
    }
    toggle && toggle.addEventListener('click', openSidebar);
    overlay && overlay.addEventListener('click', closeSidebar);
  })();

  (function () {
    const btn = document.getElementById('mobileFullscreenToggle');
    const icon = document.getElementById('mobileFullscreenIcon');
    if (!btn || !icon) return;
    const FS_PREF_KEY = 'vetsim_mobile_fullscreen_pref';
    const FS_FALLBACK_KEY = 'vetsim_mobile_fullscreen_fallback';
    function setPref(v) {
      try { sessionStorage.setItem(FS_PREF_KEY, v ? '1' : '0'); } catch (_) {}
      try { localStorage.setItem(FS_PREF_KEY, v ? '1' : '0'); } catch (_) {}
    }
    function getPref() {
      try {
        const s = sessionStorage.getItem(FS_PREF_KEY);
        if (s === '1' || s === '0') return s === '1';
      } catch (_) {}
      try {
        const l = localStorage.getItem(FS_PREF_KEY);
        if (l === '1' || l === '0') return l === '1';
      } catch (_) {}
      return false;
    }

    const canFs = !!(
      document.documentElement.requestFullscreen ||
      document.documentElement.webkitRequestFullscreen ||
      document.exitFullscreen ||
      document.webkitExitFullscreen
    );

    if (!canFs) {
      btn.style.display = 'none';
      return;
    }

    function isFullscreen() {
      return !!(document.fullscreenElement || document.webkitFullscreenElement);
    }

    function syncIcon() {
      const open = isFullscreen();
      icon.className = open ? 'bi bi-fullscreen-exit' : 'bi bi-arrows-fullscreen';
      btn.setAttribute('aria-label', open ? 'Sair da tela cheia' : 'Entrar em tela cheia');
      btn.setAttribute('title', open ? 'Sair da tela cheia' : 'Tela cheia');
      if (open) setPref(true);
    }

    function setFallbackMode(on) {
      try { sessionStorage.setItem(FS_FALLBACK_KEY, on ? '1' : '0'); } catch (_) {}
      document.body.classList.toggle('vs-force-fullscreen', !!on);
    }

    (function restoreFallbackMode() {
      try {
        if (sessionStorage.getItem(FS_FALLBACK_KEY) === '1') {
          document.body.classList.add('vs-force-fullscreen');
        }
      } catch (_) {}
    })();

    async function requestFullscreenSafe() {
      const el = document.documentElement;
      if (el.requestFullscreen) await el.requestFullscreen();
      else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
    }

    async function exitFullscreenSafe() {
      if (document.exitFullscreen) await document.exitFullscreen();
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    }

    async function toggleFullscreen() {
      try {
        if (isFullscreen()) {
          await exitFullscreenSafe();
          setPref(false);
          setFallbackMode(false);
        } else {
          try {
            await requestFullscreenSafe();
            setFallbackMode(false);
          } catch (_) {
            // Fallback para navegadores/páginas que negam fullscreen real.
            setFallbackMode(true);
          }
          setPref(true);
        }
      } catch (_) {}
      syncIcon();
    }

    // Persiste entre views: navegadores mobile exigem gesto para entrar em fullscreen.
    // Mantém tentativas após navegação até conseguir restaurar.
    (function restoreFullscreenOnGestureUntilSuccess() {
      let bound = false;

      function wantsFullscreen() {
        return getPref();
      }

      function unbind() {
        if (!bound) return;
        document.removeEventListener('pointerdown', tryEnter, true);
        document.removeEventListener('pointerup', tryEnter, true);
        document.removeEventListener('touchstart', tryEnter, true);
        document.removeEventListener('touchend', tryEnter, true);
        document.removeEventListener('click', tryEnter, true);
        bound = false;
      }

      function tryEnter() {
        if (!wantsFullscreen()) return unbind();
        if (isFullscreen()) return unbind();
        try {
          const el = document.documentElement;
          const p = el.requestFullscreen ? el.requestFullscreen() : (el.webkitRequestFullscreen ? el.webkitRequestFullscreen() : null);
          if (p && typeof p.then === 'function') {
            p.then(function () {
              setFallbackMode(false);
              syncIcon();
              if (isFullscreen()) unbind();
            }).catch(function () {
              setFallbackMode(true);
              syncIcon();
            });
            return;
          }
        } catch (_) {}
        if (!isFullscreen()) setFallbackMode(true);
        syncIcon();
        if (isFullscreen()) unbind();
      }

      function bind() {
        if (bound || !wantsFullscreen() || isFullscreen()) return;
        document.addEventListener('pointerdown', tryEnter, true);
        document.addEventListener('pointerup', tryEnter, true);
        document.addEventListener('touchstart', tryEnter, true);
        document.addEventListener('touchend', tryEnter, true);
        document.addEventListener('click', tryEnter, true);
        bound = true;
      }

      bind();
      // Alguns navegadores permitem restaurar fullscreen sem gesto após navegação.
      // Tentamos também nesses eventos para cobrir mais páginas/dispositivos.
      setTimeout(tryEnter, 0);
      window.addEventListener('load', tryEnter);
      window.addEventListener('pageshow', bind);
      window.addEventListener('pageshow', tryEnter);
      document.addEventListener('visibilitychange', function () {
        if (!document.hidden) { bind(); tryEnter(); }
      });
    })();

    btn.addEventListener('click', toggleFullscreen);
    document.addEventListener('fullscreenchange', syncIcon);
    document.addEventListener('webkitfullscreenchange', syncIcon);
    syncIcon();
  })();
</script>
