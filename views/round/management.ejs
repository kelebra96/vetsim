<!doctype html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
    <title>VetSim</title>
    <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/round.css">
</head>

<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary" id="navbarHome">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">VetSim</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" aria-current="page" href="/home">Home</a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                            aria-expanded="false">
                            Usuários
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/register">Criação</a></li>
                            <li><a class="dropdown-item" href="#">Atualização</a></li>
                            <li>
                                <hr class="dropdown-divider">
                            </li>
                            <li><a class="dropdown-item" href="#">Lista de Usuários</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Sobre</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/roundcreate">Rounds</a>

                    </li>
                </ul>
                <li class="nav-item d-flex">
                    <a class="nav-link active" href="/login">
                        <i class="bi bi-door-open"></i>
                        Logout
                    </a>
                </li>
            </div>
        </div>
    </nav>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="text-center my-5">Vamos fazer um Round</h1>
            </div>
        </div>
        <form action="/createround" method="POST">
            <div class="container">
                <% if (messages && messages.length> 0) { %>
                    <div class="alert alert-danger mt-3">
                        <ul>
                            <% messages.forEach(function(msg) { %>
                                <li>
                                    <%= msg %>
                                </li>
                                <% }) %>
                        </ul>
                    </div>
                    <% } %>
                
                        <% if (success && success.length> 0) { %>
                            <div class="alert alert-success mt-3">
                                <%= success %>
                            </div>
                            <% } %>

            <fieldset>
                <legend>Rounds Liberados</legend>
                <div class="mb-3">
                    <% if (round) { %>
                        <form action="/roundupdate/<%= round._id %>" method="POST">
                            <div class="card mt-4">
                                <div class="card-body">
                                    <h5 class="card-title">Round Liberado</h5>
                                    <p class="card-text">Número: <%= round.numberRound %>
                                    </p>
                                    <p class="card-text">Semestre: <%= round.semester %>
                                    </p>
                    
                                    <div class="form-group mb-3">
                                        <label for="shelter">Abrigo</label>
                                        <input type="number" class="form-control" id="shelter" name="shelter" min="0" required
                                            value="<%= round.shelter %>">
                                    </div>
                    
                                    <div class="form-group mb-3">
                                        <label for="quantMales">Machos Castrados</label>
                                        <input type="number" class="form-control" id="quantMales" name="quantMales" min="0" required
                                            value="<%= round.quantMales %>">
                                    </div>
                    
                                    <div class="form-group mb-3">
                                        <label for="quantFemales">Fêmeas Castradas</label>
                                        <input type="number" class="form-control" id="quantFemales" name="quantFemales" min="0" required
                                            value="<%= round.quantFemales %>">
                                    </div>
                    
                                    <button type="submit" class="btn btn-success">Salvar Dados</button>
                                </div>
                            </div>
                        </form>
                        <% } %>                                          
                </div>
            </fieldset>
                  
            </div>
        </form>
    </div>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>