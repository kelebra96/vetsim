<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/img/gato-preto.svg" />
  <title>Meu Round • VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/round.css">
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>
  <div class="vs-main">
    <%
      const _round   = locals.round || null;
      const _costs   = locals.costs  || {};
      const _msgs    = locals.messages || [];
      const _success = locals.success  || '';

      const shelterCost      = Number(_costs.shelterCost      || 0);
      const maleNeuterCost   = Number(_costs.maleNeuterCost   || 0);
      const femaleNeuterCost = Number(_costs.femaleNeuterCost || 0);

      const curShelter  = _round ? Number(_round.shelter     || 0) : 0;
      const curMales    = _round ? Number(_round.quantMales   || 0) : 0;
      const curFemales  = _round ? Number(_round.quantFemales || 0) : 0;

      const totalCost = (curShelter * shelterCost) + (curMales * maleNeuterCost) + (curFemales * femaleNeuterCost);
      const isOpen    = _round ? _round.status !== false : false;
      const _userBal  = locals.user ? (Number.isFinite(Number(locals.user.balance)) ? Number(locals.user.balance) : 50000) : 0;
    %>

    <div class="round-shell">

      <!-- ── Header ── -->
      <div class="rnd-header">
        <div>
          <p class="rnd-kicker">Simulação</p>
          <h1 class="rnd-header-title">Meu Round</h1>
          <% if (_round) { %>
          <div class="rnd-info-chips mt-2">
            <span class="rnd-chip"><i class="bi bi-hash"></i> Round <strong><%= _round.numberRound %></strong></span>
            <span class="rnd-chip"><i class="bi bi-mortarboard"></i> Semestre <strong><%= _round.semester %></strong></span>
          </div>
          <% } %>
        </div>
        <% if (_round) { %>
        <span class="rnd-badge <%= isOpen ? 'open' : 'closed' %>">
          <i class="bi bi-<%= isOpen ? 'unlock-fill' : 'lock-fill' %>"></i>
          <%= isOpen ? 'Aberto' : 'Encerrado' %>
        </span>
        <% } %>
      </div>

      <!-- ── Alertas ── -->
      <% if (_msgs && _msgs.length > 0) { %>
      <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="background:rgba(220,38,58,0.12);border:1px solid rgba(220,38,58,0.25);color:#f87171;border-radius:12px;">
        <ul class="mb-0 ps-3">
          <% _msgs.forEach(function(msg){ %><li><%= msg %></li><% }) %>
        </ul>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
      <% } %>

      <% if (_success && _success.length > 0) { %>
      <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="background:rgba(58,181,160,0.12);border:1px solid rgba(58,181,160,0.25);color:var(--vs-accent);border-radius:12px;">
        <i class="bi bi-check-circle-fill me-2"></i><%= _success %>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
      <% } %>

      <% if (_round) { %>

      <!-- ── Layout principal ── -->
      <div class="row g-4">

        <!-- ── Coluna esquerda: formulário ── -->
        <div class="col-12 col-lg-7">
          <form action="/roundupdate/<%= _round._id %>" method="POST" id="form-round">

            <!-- Machos -->
            <div class="rnd-input-group mb-3">
              <label class="rnd-input-label" for="quantMales">
                <i class="bi bi-gender-male"></i> Machos Castrados
                <span class="cost-hint">× <%= maleNeuterCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %> / un.</span>
              </label>
              <input
                type="number"
                class="form-control rnd-field"
                id="quantMales"
                name="quantMales"
                min="0"
                required
                value="<%= curMales %>"
                data-cost="<%= maleNeuterCost %>"
                data-target="cost-males"
                <% if (!isOpen) { %>disabled<% } %>
              >
              <div class="rnd-field-error" id="error-quantMales"></div>
            </div>

            <!-- Fêmeas -->
            <div class="rnd-input-group mb-3">
              <label class="rnd-input-label" for="quantFemales">
                <i class="bi bi-gender-female"></i> Fêmeas Castradas
                <span class="cost-hint">× <%= femaleNeuterCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %> / un.</span>
              </label>
              <input
                type="number"
                class="form-control rnd-field"
                id="quantFemales"
                name="quantFemales"
                min="0"
                required
                value="<%= curFemales %>"
                data-cost="<%= femaleNeuterCost %>"
                data-target="cost-females"
                <% if (!isOpen) { %>disabled<% } %>
              >
              <div class="rnd-field-error" id="error-quantFemales"></div>
            </div>

            <!-- Abrigo -->
            <div class="rnd-input-group mb-4">
              <label class="rnd-input-label" for="shelter">
                <i class="bi bi-house-heart-fill"></i> Animais no Abrigo
                <span class="cost-hint">× <%= shelterCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %> / un.</span>
              </label>
              <input
                type="number"
                class="form-control rnd-field"
                id="shelter"
                name="shelter"
                min="0"
                required
                value="<%= curShelter %>"
                data-cost="<%= shelterCost %>"
                data-target="cost-shelter"
                <% if (!isOpen) { %>disabled<% } %>
              >
              <div class="rnd-field-error" id="error-shelter"></div>
            </div>

            <% if (isOpen) { %>
            <button type="submit" class="btn-rnd-save">
              <i class="bi bi-floppy-fill me-2"></i>Salvar Dados do Round
            </button>
            <% } else { %>
            <div class="rnd-closed-notice">
              <i class="bi bi-lock-fill me-1"></i> Este round foi encerrado e não pode ser editado.
            </div>
            <% } %>

          </form>
        </div>

        <!-- ── Coluna direita: custos + saldo ── -->
        <div class="col-12 col-lg-5">

          <!-- Painel de custos -->
          <div class="rnd-cost-panel mb-3">
            <div class="rnd-cost-panel-title"><i class="bi bi-receipt me-1"></i> Resumo de Custos</div>

            <div class="rnd-cost-row">
              <span class="rnd-cost-row-label"><i class="bi bi-gender-male"></i> Castração de machos</span>
              <span class="rnd-cost-row-val" id="cost-males">
                <%= (curMales * maleNeuterCost).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %>
              </span>
            </div>

            <div class="rnd-cost-row">
              <span class="rnd-cost-row-label"><i class="bi bi-gender-female"></i> Castração de fêmeas</span>
              <span class="rnd-cost-row-val" id="cost-females">
                <%= (curFemales * femaleNeuterCost).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %>
              </span>
            </div>

            <div class="rnd-cost-row">
              <span class="rnd-cost-row-label"><i class="bi bi-house-heart"></i> Abrigo</span>
              <span class="rnd-cost-row-val" id="cost-shelter">
                <%= (curShelter * shelterCost).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %>
              </span>
            </div>

            <div class="rnd-cost-row total">
              <span class="rnd-cost-row-label"><i class="bi bi-sigma"></i> Total deste round</span>
              <span class="rnd-cost-row-val" id="cost-total">
                <%= totalCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %>
              </span>
            </div>
          </div>

          <!-- Painel de impacto no saldo -->
          <div class="rnd-balance-panel">
            <p class="rnd-balance-panel-title"><i class="bi bi-wallet2 me-1"></i> Impacto no Saldo</p>

            <div class="rnd-balance-row">
              <span class="rnd-balance-label"><i class="bi bi-cash-coin"></i> Saldo atual</span>
              <span class="rnd-balance-val"><%= _userBal.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
            <hr class="rnd-balance-divider">
            <div class="rnd-balance-row">
              <span class="rnd-balance-label"><i class="bi bi-receipt"></i> Custo estimado</span>
              <span class="rnd-balance-val" id="impact-cost"><%= totalCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
            <hr class="rnd-balance-divider">
            <div class="rnd-balance-row">
              <span class="rnd-balance-label"><i class="bi bi-wallet-fill"></i> Saldo após salvar</span>
              <span class="rnd-balance-val <%= (_userBal - totalCost) < 0 ? 'negative' : '' %>" id="impact-after"><%= (_userBal - totalCost).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
          </div>

        </div>
      </div>

      <% } else { %>

      <!-- ── Estado vazio + custos visíveis ── -->
      <div class="row g-4">
        <div class="col-12 col-lg-7">
          <div class="rnd-empty">
            <div class="rnd-empty-icon"><i class="bi bi-hourglass-split"></i></div>
            <h2 class="rnd-empty-title">Nenhum round disponível</h2>
            <p class="rnd-empty-desc">Aguarde seu professor liberar o próximo round para o seu semestre.</p>
          </div>
        </div>
        <div class="col-12 col-lg-5">
          <div class="rnd-cost-panel mb-3">
            <div class="rnd-cost-panel-title"><i class="bi bi-receipt me-1"></i> Resumo de Custos</div>

            <div class="rnd-cost-row">
              <span class="rnd-cost-row-label"><i class="bi bi-gender-male"></i> Castração de machos</span>
              <span class="rnd-cost-row-val"><%= (0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>

            <div class="rnd-cost-row">
              <span class="rnd-cost-row-label"><i class="bi bi-gender-female"></i> Castração de fêmeas</span>
              <span class="rnd-cost-row-val"><%= (0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>

            <div class="rnd-cost-row">
              <span class="rnd-cost-row-label"><i class="bi bi-house-heart"></i> Abrigo</span>
              <span class="rnd-cost-row-val"><%= (0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>

            <div class="rnd-cost-row total">
              <span class="rnd-cost-row-label"><i class="bi bi-sigma"></i> Total deste round</span>
              <span class="rnd-cost-row-val"><%= (0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
          </div>

          <div class="rnd-balance-panel">
            <p class="rnd-balance-panel-title">Tabela de Preços</p>

            <div class="rnd-balance-row">
              <span class="rnd-balance-label"><i class="bi bi-house-heart"></i> Abrigo / animal</span>
              <span class="rnd-balance-val"><%= shelterCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
            <hr class="rnd-balance-divider">
            <div class="rnd-balance-row">
              <span class="rnd-balance-label"><i class="bi bi-gender-male"></i> Castração macho</span>
              <span class="rnd-balance-val"><%= maleNeuterCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
            <hr class="rnd-balance-divider">
            <div class="rnd-balance-row">
              <span class="rnd-balance-label"><i class="bi bi-gender-female"></i> Castração fêmea</span>
              <span class="rnd-balance-val"><%= femaleNeuterCost.toLocaleString('pt-BR',{style:'currency',currency:'BRL'}) %></span>
            </div>
          </div>
        </div>
      </div>

      <% } %>

    </div>

    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/gamification.js"></script>
    <script>
      (function () {
        const fmt = (v) => v.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        const userBalance = <%= _userBal %>;

        function recalc() {
          let total = 0;
          document.querySelectorAll('input[data-cost]').forEach(function (inp) {
            const qty  = Math.max(0, parseInt(inp.value, 10) || 0);
            const cost = parseFloat(inp.dataset.cost) || 0;
            const sub  = qty * cost;
            total += sub;
            const el = document.getElementById(inp.dataset.target);
            if (el) el.textContent = fmt(sub);
          });
          const totEl = document.getElementById('cost-total');
          if (totEl) totEl.textContent = fmt(total);

          const costEl  = document.getElementById('impact-cost');
          const afterEl = document.getElementById('impact-after');
          if (costEl) costEl.textContent = fmt(total);
          if (afterEl) {
            const after = userBalance - total;
            afterEl.textContent = fmt(after);
            afterEl.classList.toggle('negative', after < 0);
          }
        }

        function clearFieldError(inp) {
          const errEl = document.getElementById('error-' + inp.id);
          const groupEl = inp.closest('.rnd-input-group');
          if (errEl) errEl.textContent = '';
          if (groupEl) groupEl.classList.remove('has-error');
        }

        function validate() {
          let valid = true;
          document.querySelectorAll('input[data-cost]').forEach(function (inp) {
            const val = parseInt(inp.value, 10);
            const errEl = document.getElementById('error-' + inp.id);
            const groupEl = inp.closest('.rnd-input-group');
            if (!Number.isFinite(val) || val < 0) {
              if (errEl) errEl.textContent = 'Insira um número inteiro maior ou igual a zero.';
              if (groupEl) groupEl.classList.add('has-error');
              valid = false;
            } else {
              clearFieldError(inp);
            }
          });
          return valid;
        }

        document.querySelectorAll('input[data-cost]').forEach(function (inp) {
          inp.addEventListener('input', function () {
            clearFieldError(inp);
            recalc();
          });
        });

        const formRound = document.getElementById('form-round');
        if (formRound) {
          formRound.addEventListener('submit', function (e) {
            if (!validate()) {
              e.preventDefault();
              const firstErr = formRound.querySelector('.rnd-input-group.has-error input');
              if (firstErr) firstErr.focus();
            }
          });
        }

        document.querySelectorAll('.alert').forEach(function (el) {
          setTimeout(function () {
            try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch (_) {}
          }, 5000);
        });
      })();
    </script>
  </div>
</body>
</html>
