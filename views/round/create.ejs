<!doctype html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
    <title>VetSim</title>
    <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/round.css">
</head>

<body>
    <%- include('../partials/navbar') %>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="text-center my-5">Criar Round</h1>
            </div>
        </div>
        <form action="/createround" method="POST">
            <div class="container">
                <% if (messages && messages.length> 0) { %>
                    <div class="alert alert-danger mt-3">
                        <ul class="mb-0">
                            <% messages.forEach(function(message) { %>
                                <li>
                                    <%= message %>
                                </li>
                                <% }); %>
                        </ul>
                    </div>
                    <% } %>
                
                        <% if (success && success.length> 0) { %>
                            <div class="alert alert-success mt-3">
                                <%= success %>
                            </div>
                            <% } %>
                  
                <div class="mb-3" id="form">
                    <div class="row">
                        <div class="col">
                            <div class="mb-3">
                                <label for="name" class="form-label">Numero do Round</label>
                                <input type="number" class="form-control" id="number" name="numberRound" required>
                            </div>
                        </div>
                        <div class="col">
                            <div></div>
                            <label for="description" class="form-label">Informe o Semestre</label>
                            <input type="number" class="form-control" id="semester" name="semester" required>
                        </div>
                    </div>
                </div>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-dark btn-lg">Criar Round</button>
                    </div>
            </div>            
        </form>
    </div>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>