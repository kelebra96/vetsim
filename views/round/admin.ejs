<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Administração de Rounds</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>
  <div class="container mt-4">
    <h1 class="vs-title h3 mb-3">Rounds por Semestre</h1>
    <% if (messages && messages.length>0) { %>
      <div class="alert alert-danger"><%= messages[0] %></div>
    <% } %>
    <% if (success && success.length>0) { %>
      <div class="alert alert-success"><%= success[0] %></div>
    <% } %>

    <div class="card vs-card mb-3">
      <div class="card-body">
        <h5 class="card-title mb-1"><i class="bi bi-funnel me-2"></i>Filtros</h5>
        <p class="text-white-50 small mb-3">Selecione semestre, round e status para listar, exportar e operar em lote.</p>
        <form class="row g-3" method="GET" action="/roundsadmin" id="filter-form">
      <div class="col-12 col-md-4">
        <label class="form-label">Semestre</label>
        <select class="form-select" name="semester" required>
          <option value="" <%= !semester ? 'selected' : '' %> disabled>Selecionar...</option>
          <% for (let i=1;i<=8;i++){ %>
            <option value="<%= i %>" <%= Number(semester)===i ? 'selected' : '' %>><%= i %></option>
          <% } %>
        </select>
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label">Número do Round</label>
        <select class="form-select" name="numberRound">
          <option value="" <%= !numberRound ? 'selected' : '' %>>Todos</option>
          <% [1,2,3,4].forEach(n => { %>
            <option value="<%= n %>" <%= Number(numberRound)===n ? 'selected' : '' %> <%= (Array.isArray(existing) && existing.indexOf(n)===-1 && semester) ? 'disabled' : '' %>><%= n %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-4">
        <label class="form-label">Status</label>
        <select class="form-select" name="status">
          <option value="" <%= !statusParam ? 'selected' : '' %>>Todos</option>
          <option value="active" <%= statusParam==='active' ? 'selected' : '' %>>Ativos</option>
          <option value="closed" <%= statusParam==='closed' ? 'selected' : '' %>>Fechados</option>
        </select>
      </div>
      <div class="col-12 col-md-4 d-flex align-items-end gap-2">
        <button class="btn btn-vs-accent vs-cta w-100" type="submit"><i class="bi bi-search me-1"></i> Filtrar</button>
        <a class="btn btn-dark w-100" id="btn-export" href="#"><i class="bi bi-download me-1"></i> Exportar CSV</a>
      </div>
    </form>
      </div>
    </div>
    <div class="card vs-card mb-3">
      <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
        <% const __total = Array.isArray(list) ? list.length : 0; const __ativos = Array.isArray(list) ? list.filter(r=>r.status).length : 0; const __fechados = __total - __ativos; %>
        <h5 class="card-title w-100 mb-1">
          <i class="bi bi-lightning-charge me-2"></i>Ações em Massa
          <span class="badge text-bg-info ms-2">Total: <%= __total %></span>
          <span class="badge text-bg-success ms-2">Ativos: <%= __ativos %></span>
          <span class="badge text-bg-warning ms-2">Fechados: <%= __fechados %></span>
        </h5>
        <p class="text-white-50 small w-100 mb-2">As ações abaixo afetam todos os registros do filtro atual. Revise o resumo antes de confirmar.</p>
        <div class="text-white-50 small">
        <% if (semester) { %>
          Filtro atual — Semestre: <strong><%= semester %></strong>
          <% if (numberRound) { %> | Round: <strong><%= numberRound %></strong><% } %>
          <% if (statusParam) { %> | Status: <strong><%= statusParam==='active'?'Ativos':'Fechados' %></strong><% } %>
        <% } else { %>
          Selecione filtros para ações em massa
        <% } %>
      </div>
        <div class="w-100"><hr class="opacity-25 my-2"></div>
        <div class="d-flex flex-wrap gap-2">
        <form method="POST" action="/roundsadmin/close" id="close-form" class="m-0">
          <input type="hidden" name="semester" id="close-semester" value="<%= semester %>">
          <input type="hidden" name="numberRound" id="close-numberRound" value="<%= numberRound %>">
          <button class="btn btn-danger" id="btn-open-close-modal" type="button" <%= (semester && statusParam !== 'closed') ? '' : 'disabled' %> title="Fecha apenas rounds ativos do filtro" data-bs-toggle="modal" data-bs-target="#closeConfirmModal">
            <i class="bi bi-x-circle me-1"></i> Fechar ativos
          </button>
        </form>
        <form method="POST" action="/roundsadmin/reopen" id="reopen-form" class="m-0">
          <input type="hidden" name="semester" id="reopen-semester" value="<%= semester %>">
          <input type="hidden" name="numberRound" id="reopen-numberRound" value="<%= numberRound %>">
          <button class="btn btn-warning" id="btn-open-reopen-modal" type="button" <%= (semester && statusParam !== 'active') ? '' : 'disabled' %> title="Reabre apenas rounds fechados do filtro" data-bs-toggle="modal" data-bs-target="#reopenConfirmModal">
            <i class="bi bi-arrow-counterclockwise me-1"></i> Reabrir fechados
          </button>
        </form>
        <form method="POST" action="/roundsadmin/delete" id="delete-form" class="m-0 d-flex align-items-center gap-2">
          <input type="hidden" name="semester" id="delete-semester" value="<%= semester %>">
          <input type="hidden" name="numberRound" id="delete-numberRound" value="<%= numberRound %>">
          <input type="hidden" name="status" id="delete-status" value="<%= statusParam %>">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="delete-confirm">
            <label class="form-check-label text-white-50" for="delete-confirm">Confirmo que entendo</label>
          </div>
          <button class="btn btn-outline-danger" id="btn-delete-filter" type="button" disabled title="Selecione um semestre e marque a confirmação" data-bs-toggle="modal" data-bs-target="#deleteConfirmModal">
            <i class="bi bi-trash me-1"></i> Excluir filtro
          </button>
        </form>
      </div>
      </div>
    </div>

    <% if (Array.isArray(list) && list.length>0) { %>
      <div class="card vs-card">
        <div class="card-body">
          <div class="mb-2 d-flex flex-wrap align-items-center gap-2 text-white-50">
            <% const total = list.length; const ativos = list.filter(r=>r.status).length; const fechados = total - ativos; %>
            <span>
              Total registros: <a href="#" id="lnk-total" class="link-light text-decoration-underline"><strong><%= total %></strong></a>
            </span>
            <span class="badge text-bg-info">Total: <%= total %></span>
            <span>
              | Ativos: <a href="#" id="lnk-ativos" class="link-success text-decoration-underline"><strong><%= ativos %></strong></a>
            </span>
            <span class="badge text-bg-success">Ativos: <%= ativos %></span>
            <span>
              | Fechados: <a href="#" id="lnk-fechados" class="link-warning text-decoration-underline"><strong><%= fechados %></strong></a>
            </span>
            <span class="badge text-bg-warning">Fechados: <%= fechados %></span>
          </div>
          <div class="table-responsive">
            <table class="table table-dark table-striped align-middle mb-0">
              <thead>
                <tr>
                  <th>Semestre</th>
                  <th>Round</th>
                  <th>Código</th>
                  <th>Nome</th>
                  <th>Macho</th>
                  <th>Fêmea</th>
                  <th>Abrigo</th>
                  <th>Status</th>
                  <th>Atualizado em</th>
                </tr>
              </thead>
              <tbody>
                <% list.forEach(r => { %>
                  <tr>
                    <td><%= r.semester %></td>
                    <td><%= r.numberRound %></td>
                    <td><%= r.codeUser %></td>
                    <td><%= r.nameusr %></td>
                    <td><%= r.quantMales %></td>
                    <td><%= r.quantFemales %></td>
                    <td><%= r.shelter %></td>
                    <td>
                      <% if (r.status) { %>
                        <span class="badge text-bg-success">Ativo</span>
                      <% } else { %>
                        <span class="badge text-bg-secondary">Fechado</span>
                      <% } %>
                    </td>
                    <td><%= r.updatedAt ? new Date(r.updatedAt).toLocaleString('pt-BR') : '-' %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    <% } else if (semester) { %>
      <div class="card vs-card"><div class="card-body"><div class="alert alert-info mb-0">Nenhum registro encontrado para o filtro.</div></div></div>
    <% } else { %>
      <div class="card vs-card"><div class="card-body"><div class="text-white-50 mb-0">Selecione um semestre para exibir os rounds.</div></div></div>
    <% } %>
  </div>

  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Modal de confirmação de exclusão -->
  <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="deleteConfirmLabel">Confirmar exclusão do filtro</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Você está prestes a excluir TODOS os rounds que correspondem ao filtro abaixo:</p>
          <ul class="list-unstyled mb-2">
            <li>Semestre: <strong id="sum-semester">-</strong></li>
            <li>Round: <strong id="sum-numberRound">Todos</strong></li>
            <li>Status: <strong id="sum-status">Todos</strong></li>
          </ul>
          <div class="alert alert-danger small" role="alert">
            Esta ação é permanente e não pode ser desfeita.
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="modal-delete-confirm">
            <label class="form-check-label" for="modal-delete-confirm">Confirmo que entendo os riscos</label>
          </div>
          <div class="mt-2 text-white-50 small" id="delete-count-info">Registros a excluir: -</div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btn-modal-delete" disabled>Confirmar exclusão</button>
        </div>
      </div>
    </div>
  </div>
  <!-- Modal de confirmação de fechamento -->
  <div class="modal fade" id="closeConfirmModal" tabindex="-1" aria-labelledby="closeConfirmLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="closeConfirmLabel">Confirmar fechamento de rounds ativos</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Esta ação fechará todos os rounds ATIVOS do filtro:</p>
          <ul class="list-unstyled mb-2">
            <li>Semestre: <strong id="close-sem-sum">-</strong></li>
            <li>Round: <strong id="close-nr-sum">Todos</strong></li>
          </ul>
          <div class="mt-2 text-white-50 small" id="close-count-info">Registros a fechar: -</div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="modal-close-confirm">
            <label class="form-check-label" for="modal-close-confirm">Confirmo que entendo</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-danger" id="btn-modal-close" disabled>Confirmar fechamento</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal de confirmação de reabertura -->
  <div class="modal fade" id="reopenConfirmModal" tabindex="-1" aria-labelledby="reopenConfirmLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="reopenConfirmLabel">Confirmar reabertura de rounds fechados</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p class="mb-2">Esta ação reabrirá todos os rounds FECHADOS do filtro:</p>
          <ul class="list-unstyled mb-2">
            <li>Semestre: <strong id="reopen-sem-sum">-</strong></li>
            <li>Round: <strong id="reopen-nr-sum">Todos</strong></li>
          </ul>
          <div class="mt-2 text-white-50 small" id="reopen-count-info">Registros a reabrir: -</div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="modal-reopen-confirm">
            <label class="form-check-label" for="modal-reopen-confirm">Confirmo que entendo</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="button" class="btn btn-warning" id="btn-modal-reopen" disabled>Confirmar reabertura</button>
        </div>
      </div>
    </div>
  </div>
  <script>
    (function(){
      const form = document.getElementById('filter-form');
      const btnExport = document.getElementById('btn-export');
      function updateExportHref(){
        if (!form || !btnExport) return;
        const sem = form.querySelector('select[name="semester"]').value;
        const nr = form.querySelector('select[name="numberRound"]').value;
        const st = form.querySelector('select[name="status"]').value;
        if (!sem) { btnExport.href = '#'; btnExport.classList.add('disabled'); return; }
        const q = new URLSearchParams({ semester: sem, numberRound: nr, status: st }).toString();
        btnExport.href = '/roundsadmin/export?' + q;
        btnExport.classList.remove('disabled');
      }
      form && form.addEventListener('change', updateExportHref);
      updateExportHref();
      // Sync hidden fields for close form
      const closeSem = document.getElementById('close-semester');
      const closeNr = document.getElementById('close-numberRound');
      const reopenSem = document.getElementById('reopen-semester');
      const reopenNr = document.getElementById('reopen-numberRound');
      const deleteSem = document.getElementById('delete-semester');
      const deleteNr = document.getElementById('delete-numberRound');
      const deleteSt = document.getElementById('delete-status');
      function syncClose(){
        if (!form || !closeSem || !closeNr) return;
        closeSem.value = form.querySelector('select[name="semester"]').value || '';
        closeNr.value = form.querySelector('select[name="numberRound"]').value || '';
        if (reopenSem && reopenNr) {
          reopenSem.value = closeSem.value;
          reopenNr.value = closeNr.value;
        }
        if (deleteSem && deleteNr && deleteSt) {
          deleteSem.value = closeSem.value;
          deleteNr.value = closeNr.value;
          deleteSt.value = form.querySelector('select[name="status"]').value || '';
        }
        // Enable/disable delete button based on filters and confirmation checkbox
        const btnDel = document.getElementById('btn-delete-filter');
        const conf = document.getElementById('delete-confirm');
        if (btnDel && conf) {
          const hasSemester = !!closeSem.value;
          btnDel.disabled = !(hasSemester && conf.checked);
        }
      }
      form && form.addEventListener('change', syncClose);
      const confCb = document.getElementById('delete-confirm');
      confCb && confCb.addEventListener('change', syncClose);
      syncClose();
      // Links de contagem: abrir modais
      function openModalById(id){
        const el = document.getElementById(id);
        if (!el) return;
        const modal = new bootstrap.Modal(el);
        modal.show();
      }
      const lnkTotal = document.getElementById('lnk-total');
      const lnkAt = document.getElementById('lnk-ativos');
      const lnkFe = document.getElementById('lnk-fechados');
      if (lnkTotal) lnkTotal.addEventListener('click', function(e){ e.preventDefault(); if (!closeSem.value) return; openModalById('deleteConfirmModal'); });
      if (lnkAt) lnkAt.addEventListener('click', function(e){ e.preventDefault(); if (!closeSem.value) return; openModalById('closeConfirmModal'); });
      if (lnkFe) lnkFe.addEventListener('click', function(e){ e.preventDefault(); if (!closeSem.value) return; openModalById('reopenConfirmModal'); });
      // Modal: excluir — preencher resumo e controlar confirmação
      const modalEl = document.getElementById('deleteConfirmModal');
      if (modalEl) {
        modalEl.addEventListener('show.bs.modal', async function(){
          const sem = form.querySelector('select[name="semester"]').value || '-';
          const nr = form.querySelector('select[name="numberRound"]').value || '';
          const st = form.querySelector('select[name="status"]').value || '';
          document.getElementById('sum-semester').textContent = sem;
          document.getElementById('sum-numberRound').textContent = nr ? nr : 'Todos';
          document.getElementById('sum-status').textContent = st === 'active' ? 'Ativos' : (st === 'closed' ? 'Fechados' : 'Todos');
          const cb = document.getElementById('modal-delete-confirm');
          const btn = document.getElementById('btn-modal-delete');
          const info = document.getElementById('delete-count-info');
          if (cb && btn) {
            cb.checked = false;
            btn.disabled = true;
            cb.onchange = function(){ btn.disabled = !cb.checked; };
          }
          // Buscar contagem para o resumo
          try {
            const q = new URLSearchParams({ semester: sem, numberRound: nr, status: st }).toString();
            const resp = await fetch('/roundsadmin/count?' + q);
            if (resp.ok) {
              const data = await resp.json();
              const c = Number(data.count || 0);
              if (info) info.textContent = `Registros a excluir: ${c}`;
              if (btn) btn.disabled = btn.disabled || (c === 0); // não permite excluir se não há registros
            } else {
              if (info) info.textContent = 'Registros a excluir: -';
            }
          } catch (e) {
            if (info) info.textContent = 'Registros a excluir: -';
          }
        });
        const btnModal = document.getElementById('btn-modal-delete');
        if (btnModal) {
          btnModal.addEventListener('click', function(){
            // Submete o form de exclusão real
            const formDelete = document.getElementById('delete-form');
            if (formDelete) formDelete.submit();
          });
        }
      }
      // Modal: fechar — contar ativos e confirmar
      const closeModalEl = document.getElementById('closeConfirmModal');
      if (closeModalEl) {
        closeModalEl.addEventListener('show.bs.modal', async function(){
          const sem = form.querySelector('select[name="semester"]').value || '-';
          const nr = form.querySelector('select[name="numberRound"]').value || '';
          document.getElementById('close-sem-sum').textContent = sem;
          document.getElementById('close-nr-sum').textContent = nr ? nr : 'Todos';
          const info = document.getElementById('close-count-info');
          const cb = document.getElementById('modal-close-confirm');
          const btn = document.getElementById('btn-modal-close');
          if (cb && btn) { cb.checked = false; btn.disabled = true; cb.onchange = function(){ btn.disabled = !cb.checked; }; }
          try {
            const q = new URLSearchParams({ semester: sem, numberRound: nr, status: 'active' }).toString();
            const resp = await fetch('/roundsadmin/count?' + q);
            const data = resp.ok ? await resp.json() : { count: 0 };
            const c = Number(data.count || 0);
            if (info) info.textContent = `Registros a fechar: ${c}`;
            if (btn) btn.disabled = btn.disabled || (c === 0);
          } catch (e) { if (info) info.textContent = 'Registros a fechar: -'; }
        });
        const btnClose = document.getElementById('btn-modal-close');
        if (btnClose) btnClose.addEventListener('click', function(){ const f = document.getElementById('close-form'); if (f) f.submit(); });
      }
      // Modal: reabrir — contar fechados e confirmar
      const reopenModalEl = document.getElementById('reopenConfirmModal');
      if (reopenModalEl) {
        reopenModalEl.addEventListener('show.bs.modal', async function(){
          const sem = form.querySelector('select[name="semester"]').value || '-';
          const nr = form.querySelector('select[name="numberRound"]').value || '';
          document.getElementById('reopen-sem-sum').textContent = sem;
          document.getElementById('reopen-nr-sum').textContent = nr ? nr : 'Todos';
          const info = document.getElementById('reopen-count-info');
          const cb = document.getElementById('modal-reopen-confirm');
          const btn = document.getElementById('btn-modal-reopen');
          if (cb && btn) { cb.checked = false; btn.disabled = true; cb.onchange = function(){ btn.disabled = !cb.checked; }; }
          try {
            const q = new URLSearchParams({ semester: sem, numberRound: nr, status: 'closed' }).toString();
            const resp = await fetch('/roundsadmin/count?' + q);
            const data = resp.ok ? await resp.json() : { count: 0 };
            const c = Number(data.count || 0);
            if (info) info.textContent = `Registros a reabrir: ${c}`;
            if (btn) btn.disabled = btn.disabled || (c === 0);
          } catch (e) { if (info) info.textContent = 'Registros a reabrir: -'; }
        });
        const btnReopen = document.getElementById('btn-modal-reopen');
        if (btnReopen) btnReopen.addEventListener('click', function(){ const f = document.getElementById('reopen-form'); if (f) f.submit(); });
      }
    })();
  </script>
</body>
</html>
