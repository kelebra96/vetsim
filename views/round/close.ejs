<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
  <title>Fechar Round • VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/roundclose.css">
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>

  <div class="vs-main">
    <div class="rcl-page">
      <header class="rcl-header">
        <div>
          <p class="rcl-kicker">Operações acadêmicas</p>
          <h1 class="rcl-title">Fechar Round</h1>
          <p class="rcl-subtitle">Finalize um round para gerar estatísticas e consolidar os dados do semestre selecionado.</p>
        </div>
        <a class="rcl-back" href="/roundsadmin"><i class="bi bi-arrow-left"></i> Voltar</a>
      </header>

      <% if (messages && messages.length > 0) { %>
        <div class="alert alert-dismissible fade show rcl-alert rcl-alert-danger" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <div><%= messages[0] %></div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
      <% } %>

      <% if (success && success.length > 0) { %>
        <div class="alert alert-dismissible fade show rcl-alert rcl-alert-success" role="alert">
          <i class="bi bi-check-circle-fill"></i>
          <div><%= success[0] %></div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fechar"></button>
        </div>
      <% } %>

      <section class="rcl-card">
        <div class="rcl-card-head">
          <h2><i class="bi bi-lock-fill"></i> Configuração de fechamento</h2>
        </div>

        <div class="rcl-card-body">
          <form id="closeRoundForm" action="/roundclose" method="POST" novalidate>
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="rcl-label" for="numberRound">Número do Round (1 a 4)</label>
                <div class="input-group rcl-group">
                  <span class="input-group-text"><i class="bi bi-hash"></i></span>
                  <input id="numberRound" type="number" class="form-control rcl-input" name="numberRound" min="1" max="4" required>
                </div>
              </div>

              <div class="col-12 col-md-6">
                <label class="rcl-label" for="semester">Semestre (1 a 8)</label>
                <div class="input-group rcl-group">
                  <span class="input-group-text"><i class="bi bi-mortarboard-fill"></i></span>
                  <input id="semester" type="number" class="form-control rcl-input" name="semester" min="1" max="8" value="<%= (user && user.semester) ? user.semester : '' %>" required>
                </div>
                <% if (user && user.semester) { %>
                  <p class="rcl-field-hint">Seu semestre atual: <span class="rcl-chip"><%= user.semester %>º</span></p>
                <% } %>
              </div>

              <div class="col-12">
                <div class="rcl-info">
                  <i class="bi bi-info-circle-fill"></i>
                  <p>O fechamento gera estatísticas e gráficos do round selecionado. Se as dependências de gráficos não estiverem disponíveis, os gráficos podem não ser exibidos.</p>
                </div>
              </div>

              <div class="col-12">
                <div id="precheck-alert" class="alert alert-warning d-none rcl-precheck" role="alert"></div>
              </div>

              <div class="col-12">
                <button id="btnClose" class="btn rcl-btn-close">
                  <i class="bi bi-check2-circle"></i>
                  Fechar Round e Gerar Gráficos
                </button>
              </div>
            </div>
          </form>
        </div>
      </section>
    </div>
  </div>

  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    (function(){
      document.querySelectorAll('.alert').forEach(function(el){
        setTimeout(function(){ try { bootstrap.Alert.getOrCreateInstance(el).close(); } catch (_) {} }, 5000);
      });
    })();
  </script>
  <script>
    // Pré-validação: verifica existência de registros antes de enviar
    (function () {
      const form = document.getElementById('closeRoundForm');
      const btn = document.getElementById('btnClose');
      const alertBox = document.getElementById('precheck-alert');
      if (!form || !btn) return;

      function setButtonState(mode) {
        if (mode === 'validating') {
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Validando...';
          return;
        }
        if (mode === 'closing') {
          btn.disabled = true;
          btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Fechando...';
          return;
        }
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check2-circle"></i> Fechar Round e Gerar Gráficos';
      }

      form.addEventListener('submit', async function (ev) {
        try {
          ev.preventDefault();
          alertBox && alertBox.classList.add('d-none');

          const sem = Number(form.elements['semester'].value || '');
          const nr = Number(form.elements['numberRound'].value || '');

          if (!Number.isFinite(sem) || sem < 1 || sem > 8 || !Number.isFinite(nr) || nr < 1 || nr > 4) {
            if (alertBox) {
              alertBox.textContent = 'Informe semestre (1-8) e número do round (1-4).';
              alertBox.classList.remove('d-none');
            }
            return;
          }

          setButtonState('validating');

          const r = await fetch('/roundslist?semester=' + encodeURIComponent(sem));
          if (!r.ok) throw new Error('Falha ao consultar rounds');
          const data = await r.json();
          const list = Array.isArray(data.list) ? data.list : [];
          const found = list.find(function(it){ return Number(it.numberRound) === nr; });
          const count = found ? Number(found.count || 0) : 0;

          if (count <= 0) {
            if (alertBox) {
              alertBox.innerHTML = 'Nenhum registro encontrado para Semestre <strong>' + sem + '</strong> e Round <strong>' + nr + '</strong>.';
              alertBox.classList.remove('d-none');
            }
            setButtonState('idle');
            return;
          }

          setButtonState('closing');
          form.submit();
        } catch (_e) {
          if (alertBox) {
            alertBox.textContent = 'Não foi possível validar os dados. Tente novamente.';
            alertBox.classList.remove('d-none');
          }
          setButtonState('idle');
        }
      });
    })();
  </script>
</body>
</html>
