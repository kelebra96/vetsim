<!doctype html>
<html lang="pt-br">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" type="image/svg+xml" href="/gato-preto.svg" />
    <title>VetSim</title>
    <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/theme.css">
</head>

<body class="vs-gradient">
<%- include('../partials/navbar') %>

    <div class="container mt-5">
        <h1>Fechar Round</h1>

        <% if (messages && messages.length> 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= messages[0] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        <% } %>
        <% if (success && success.length> 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success[0] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        <% } %>

        <form action="/roundclose" method="POST">
            <div class="mb-3">
                <label>Número do Round</label>
                <input type="number" class="form-control" name="numberRound" required>
            </div>
            <div class="mb-3">
                <label>Semestre</label>
                <input type="number" class="form-control" name="semester" min="1" max="8" value="<%= (user && user.semester) ? user.semester : ' %>" required>
            </div>
            <button class="btn btn-danger">Fechar Round e Gerar Gráficos</button>
        </form>
    </div>
    <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/gamification.js"></script>
    <script>
      (function(){
        document.querySelectorAll('.alert').forEach(function(el){
          setTimeout(function(){ try{ bootstrap.Alert.getOrCreateInstance(el).close(); }catch(_){} }, 5000);
        });
      })();
    </script>
    
    </body>
    
    </html>
