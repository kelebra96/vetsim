<!doctype html>
<html lang="pt-br">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="icon" type="image/svg+xml" href="/img/gato-preto.svg" />
  <title>Gráficos • VetSim</title>
  <link href="/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/theme.css">
  <link rel="stylesheet" href="/css/roundgraph.css">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="vs-gradient">
  <%- include('../partials/navbar') %>

  <div class="vs-main">
    <div class="rg-page">
      <header class="rg-header">
        <div>
          <p class="rg-kicker">Análise de Fechamento</p>
          <h1 class="rg-title">Round <%= numberRound %> • Semestre <%= semester %></h1>
          <p class="rg-subtitle">Evolução populacional simulada por aluno após o fechamento do round.</p>
        </div>
        <div class="rg-summary-pill">
          <i class="bi bi-people-fill"></i>
          <strong><%= Array.isArray(results) ? results.length : 0 %></strong>
          <span>aluno(s)</span>
        </div>
      </header>

      <% if (typeof warning !== 'undefined' && warning) { %>
        <div class="alert rg-alert rg-alert-warning" role="alert">
          <i class="bi bi-exclamation-triangle-fill"></i>
          <span><%= warning %></span>
        </div>
      <% } %>

      <% if (!results || results.length === 0) { %>
        <section class="rg-card">
          <div class="rg-empty">
            <i class="bi bi-bar-chart-line"></i>
            <p>Nenhum gráfico para exibir no momento.</p>
          </div>
        </section>
      <% } else { %>
        <section class="rg-grid">
          <% results.forEach((r, i) => { %>
            <article class="rg-card">
              <div class="rg-card-head">
                <div>
                  <h2 class="rg-card-title"><%= r.nameusr || 'Sem nome' %></h2>
                  <p class="rg-card-sub">Código <strong><%= r.codeUser %></strong></p>
                </div>
              </div>

              <div class="rg-metrics">
                <div class="rg-metric">
                  <span>População final</span>
                  <strong id="finalPop<%= i %>">-</strong>
                </div>
                <div class="rg-metric">
                  <span>Pico total</span>
                  <strong id="peakPop<%= i %>">-</strong>
                </div>
                <div class="rg-metric">
                  <span id="deltaLabel<%= i %>">Variação</span>
                  <strong id="deltaPop<%= i %>">-</strong>
                </div>
              </div>

              <div class="rg-timeline-wrap">
                <h3 class="rg-timeline-title">Linha do tempo dos rounds</h3>
                <div class="rg-timeline" id="timeline<%= i %>"></div>
              </div>

              <div class="rg-charts">
                <div class="rg-chart-panel">
                  <h3 class="rg-chart-title">Evolução detalhada</h3>
                  <div class="rg-chart-wrap">
                    <canvas id="chartMain<%= i %>"></canvas>
                  </div>
                </div>
                <div class="rg-chart-panel">
                  <h3 class="rg-chart-title">Projeção (Total N)</h3>
                  <div class="rg-chart-wrap">
                    <canvas id="chartProj<%= i %>"></canvas>
                  </div>
                </div>
              </div>
            </article>
          <% }); %>
        </section>
      <% } %>
    </div>
  </div>

  <script src="/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/gamification.js"></script>
  <script>
    (function () {
      const results = <%- JSON.stringify(results || []) %>;
      if (!Array.isArray(results) || results.length === 0) return;

      const numberFmt = new Intl.NumberFormat('pt-BR', { maximumFractionDigits: 0 });

      function labelsAndValues(seriesObj) {
        const labels = Object.keys(seriesObj || {});
        const values = labels.map(function (d) { return Number(seriesObj[d] || 0); });
        return { labels, values };
      }

      function combineSeries(a, b) {
        const len = Math.min(a.length, b.length);
        const out = new Array(len);
        for (let i = 0; i < len; i += 1) out[i] = Number(a[i] || 0) + Number(b[i] || 0);
        return out;
      }

      function downsample(labels, datasets, maxPoints) {
        if (!labels || labels.length <= maxPoints) return { labels, datasets };

        const stride = Math.ceil(labels.length / maxPoints);
        const sampledLabels = [];
        const sampledDatasets = datasets.map(function (ds) {
          return { label: ds.label, data: [], borderColor: ds.borderColor, backgroundColor: ds.backgroundColor, fill: ds.fill, tension: ds.tension, borderWidth: ds.borderWidth, pointRadius: ds.pointRadius };
        });

        for (let i = 0; i < labels.length; i += stride) {
          sampledLabels.push(labels[i]);
          for (let j = 0; j < datasets.length; j += 1) {
            sampledDatasets[j].data.push(datasets[j].data[i]);
          }
        }

        const lastIdx = labels.length - 1;
        if (sampledLabels[sampledLabels.length - 1] !== labels[lastIdx]) {
          sampledLabels.push(labels[lastIdx]);
          for (let j = 0; j < datasets.length; j += 1) {
            sampledDatasets[j].data.push(datasets[j].data[lastIdx]);
          }
        }

        return { labels: sampledLabels, datasets: sampledDatasets };
      }

      function setMetric(id, value, cls) {
        const el = document.getElementById(id);
        if (!el) return;
        el.textContent = value;
        el.classList.remove('is-positive', 'is-negative');
        if (cls) el.classList.add(cls);
      }

      function setText(id, value) {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
      }

      function renderTimeline(id, timeline, currentRound) {
        const el = document.getElementById(id);
        if (!el) return;
        const rows = Array.isArray(timeline) ? timeline : [];
        if (rows.length === 0) {
          el.innerHTML = '<div class="rg-tl-empty">Sem histórico de rounds.</div>';
          return;
        }

        el.innerHTML = rows.map(function (item) {
          const cls = [
            'rg-tl-item',
            item.exists ? 'exists' : 'missing',
            Number(item.round) === Number(currentRound) ? 'current' : ''
          ].join(' ').trim();

          if (!item.exists) {
            return '<div class="' + cls + '">' +
              '<div class="rg-tl-round">Round ' + item.round + '</div>' +
              '<div class="rg-tl-main">—</div>' +
              '<div class="rg-tl-sub">Sem dados</div>' +
            '</div>';
          }

          const statusLabel = item.status === 'closed' ? 'Fechado' : 'Ativo';
          return '<div class="' + cls + '">' +
            '<div class="rg-tl-round">Round ' + item.round + '</div>' +
            '<div class="rg-tl-main">' + numberFmt.format(Number(item.total || 0)) + '</div>' +
            '<div class="rg-tl-sub">' + statusLabel + ' • M ' + numberFmt.format(Number(item.males || 0)) + ' / F ' + numberFmt.format(Number(item.females || 0)) + '</div>' +
          '</div>';
        }).join('');
      }

      function addDays(isoDate, days) {
        const d = new Date(isoDate + 'T00:00:00');
        d.setDate(d.getDate() + days);
        return d.toISOString().slice(0, 10);
      }

      function linearProjection(series, horizon) {
        const n = series.length;
        if (n < 8) return null;

        const xMean = (n - 1) / 2;
        const yMean = series.reduce(function (acc, v) { return acc + v; }, 0) / n;
        let num = 0;
        let den = 0;
        for (let i = 0; i < n; i += 1) {
          const dx = i - xMean;
          num += dx * (series[i] - yMean);
          den += dx * dx;
        }
        const slope = den ? (num / den) : 0;
        const intercept = yMean - slope * xMean;

        const residuals = series.map(function (v, i) { return v - (intercept + slope * i); });
        const variance = residuals.reduce(function (acc, r) { return acc + (r * r); }, 0) / Math.max(1, n - 2);
        const sigma = Math.sqrt(variance);

        const proj = [];
        const upper = [];
        const lower = [];
        for (let i = 1; i <= horizon; i += 1) {
          const y = Math.max(0, intercept + slope * (n - 1 + i));
          const band = sigma * 1.28; // ~80%
          proj.push(y);
          upper.push(Math.max(0, y + band));
          lower.push(Math.max(0, y - band));
        }
        return { proj, upper, lower };
      }

      results.forEach(function (r, i) {
        const nSeries = labelsAndValues(r.data && r.data.n);
        const jSeries = labelsAndValues(r.data && r.data.j);
        const fiSeries = labelsAndValues(r.data && r.data.fi);
        const miSeries = labelsAndValues(r.data && r.data.mi);
        const fcSeries = labelsAndValues(r.data && r.data.fc);
        const mcSeries = labelsAndValues(r.data && r.data.mc);

        const labels = nSeries.labels;
        const total = nSeries.values;
        const jovens = jSeries.values;
        const intactos = combineSeries(fiSeries.values, miSeries.values);
        const castrados = combineSeries(fcSeries.values, mcSeries.values);

        if (total.length > 0) {
          const first = total[0];
          const last = total[total.length - 1];
          const peak = Math.max.apply(null, total);
          const delta = last - first;

          setMetric('finalPop' + i, numberFmt.format(last));
          setMetric('peakPop' + i, numberFmt.format(peak));

          const cmp = r.compare || null;
          if (cmp && cmp.hasPrevious) {
            const d = Number(cmp.deltaTotal || 0);
            setText('deltaLabel' + i, 'Δ vs round anterior');
            setMetric('deltaPop' + i, (d >= 0 ? '+' : '') + numberFmt.format(d), d >= 0 ? 'is-positive' : 'is-negative');
          } else {
            setText('deltaLabel' + i, 'Variação simulada');
            setMetric('deltaPop' + i, (delta >= 0 ? '+' : '') + numberFmt.format(delta), delta >= 0 ? 'is-positive' : 'is-negative');
          }
        }

        renderTimeline('timeline' + i, r.timeline, r.numberRound);

        const rawDatasets = [
          {
            label: 'Total (N)',
            data: total,
            borderColor: '#3ab5a0',
            backgroundColor: 'rgba(58,181,160,0.14)',
            fill: true,
            tension: 0.35,
            borderWidth: 2.2,
            pointRadius: 0
          },
          {
            label: 'Jovens (J)',
            data: jovens,
            borderColor: '#60a5fa',
            backgroundColor: 'rgba(96,165,250,0.08)',
            fill: false,
            tension: 0.32,
            borderWidth: 1.6,
            pointRadius: 0
          },
          {
            label: 'Intactos (F+M)',
            data: intactos,
            borderColor: '#fbbf24',
            backgroundColor: 'rgba(251,191,36,0.07)',
            fill: false,
            tension: 0.3,
            borderWidth: 1.4,
            pointRadius: 0
          },
          {
            label: 'Castrados (F+M)',
            data: castrados,
            borderColor: '#f472b6',
            backgroundColor: 'rgba(244,114,182,0.07)',
            fill: false,
            tension: 0.3,
            borderWidth: 1.4,
            pointRadius: 0
          }
        ];

        const sampled = downsample(labels, rawDatasets, 220);
        const mainCtx = document.getElementById('chartMain' + i);
        if (!mainCtx) return;

        new Chart(mainCtx, {
          type: 'line',
          data: {
            labels: sampled.labels,
            datasets: sampled.datasets
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
              legend: {
                labels: {
                  color: 'rgba(255,255,255,0.72)',
                  usePointStyle: true,
                  boxWidth: 7,
                  boxHeight: 7,
                  font: { size: 11, weight: '600' }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(7, 20, 18, 0.92)',
                borderColor: 'rgba(58,181,160,0.35)',
                borderWidth: 1,
                titleColor: '#d4f2ec',
                bodyColor: '#e8f5f2',
                padding: 10,
                callbacks: {
                  label: function (context) {
                    return context.dataset.label + ': ' + numberFmt.format(context.parsed.y);
                  }
                }
              }
            },
            scales: {
              x: {
                ticks: {
                  color: 'rgba(255,255,255,0.45)',
                  maxTicksLimit: 8,
                  callback: function (value, index, ticks) {
                    const label = this.getLabelForValue(value);
                    return label ? label.slice(2) : '';
                  }
                },
                grid: { color: 'rgba(255,255,255,0.06)' }
              },
              y: {
                ticks: {
                  color: 'rgba(255,255,255,0.5)',
                  callback: function (value) { return numberFmt.format(value); }
                },
                grid: { color: 'rgba(255,255,255,0.08)' }
              }
            }
          }
        });

        const histWindow = Math.min(180, labels.length);
        const histLabels = labels.slice(-histWindow);
        const histTotal = total.slice(-histWindow);
        const projSource = total.slice(-Math.min(60, total.length));
        const projection = linearProjection(projSource, 120);
        const projCtx = document.getElementById('chartProj' + i);
        if (!projCtx) return;

        if (!projection || histLabels.length === 0) {
          new Chart(projCtx, {
            type: 'line',
            data: {
              labels: histLabels,
              datasets: [{
                label: 'Total (N)',
                data: histTotal,
                borderColor: '#3ab5a0',
                backgroundColor: 'rgba(58,181,160,0.15)',
                fill: true,
                pointRadius: 0,
                tension: 0.32,
                borderWidth: 2
              }]
            },
            options: { responsive: true, maintainAspectRatio: false }
          });
          return;
        }

        const futureLabels = [];
        const lastLabel = labels[labels.length - 1];
        for (let d = 1; d <= projection.proj.length; d += 1) {
          futureLabels.push(addDays(lastLabel, d));
        }
        const allLabels = histLabels.concat(futureLabels);
        const projPad = new Array(histLabels.length).fill(null);
        const upperPad = new Array(histLabels.length).fill(null);
        const lowerPad = new Array(histLabels.length).fill(null);

        new Chart(projCtx, {
          type: 'line',
          data: {
            labels: allLabels,
            datasets: [
              {
                label: 'Histórico (N)',
                data: histTotal.concat(new Array(futureLabels.length).fill(null)),
                borderColor: '#3ab5a0',
                backgroundColor: 'rgba(58,181,160,0.12)',
                fill: true,
                pointRadius: 0,
                tension: 0.3,
                borderWidth: 2
              },
              {
                label: 'Projeção',
                data: projPad.concat(projection.proj),
                borderColor: '#fbbf24',
                backgroundColor: 'transparent',
                borderDash: [6, 6],
                pointRadius: 0,
                tension: 0.28,
                borderWidth: 2
              },
              {
                label: 'Faixa superior',
                data: upperPad.concat(projection.upper),
                borderColor: 'rgba(251,191,36,0.35)',
                backgroundColor: 'rgba(251,191,36,0.12)',
                pointRadius: 0,
                tension: 0.25,
                borderWidth: 1,
                fill: false
              },
              {
                label: 'Faixa inferior',
                data: lowerPad.concat(projection.lower),
                borderColor: 'rgba(251,191,36,0.35)',
                backgroundColor: 'rgba(251,191,36,0.12)',
                pointRadius: 0,
                tension: 0.25,
                borderWidth: 1,
                fill: '-1'
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            interaction: { mode: 'index', intersect: false },
            plugins: {
              legend: {
                labels: {
                  color: 'rgba(255,255,255,0.72)',
                  usePointStyle: true,
                  boxWidth: 7,
                  boxHeight: 7,
                  font: { size: 11, weight: '600' }
                }
              },
              tooltip: {
                backgroundColor: 'rgba(7, 20, 18, 0.92)',
                borderColor: 'rgba(251,191,36,0.35)',
                borderWidth: 1,
                titleColor: '#fff4d4',
                bodyColor: '#fff6e5',
                padding: 10,
                callbacks: {
                  label: function (context) {
                    return context.dataset.label + ': ' + numberFmt.format(context.parsed.y);
                  }
                }
              }
            },
            scales: {
              x: {
                ticks: {
                  color: 'rgba(255,255,255,0.45)',
                  maxTicksLimit: 8,
                  callback: function (value) {
                    const label = this.getLabelForValue(value);
                    return label ? label.slice(2) : '';
                  }
                },
                grid: { color: 'rgba(255,255,255,0.06)' }
              },
              y: {
                ticks: {
                  color: 'rgba(255,255,255,0.5)',
                  callback: function (value) { return numberFmt.format(value); }
                },
                grid: { color: 'rgba(255,255,255,0.08)' }
              }
            }
          }
        });
      });
    })();
  </script>
</body>
</html>
